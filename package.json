{
  "name": "iva",
  "version": "0.4.12",
  "type": "module",
  "bin": {
    "iva": "bin/iva.mjs"
  },
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "iva": "node bin/iva.mjs",
    "setup": "node scripts/setup.mjs",
    "check-port": "node scripts/check-port.ts",
    "build": "node --env-file-if-exists=.env scripts/build.ts",
    "build:core": "eve build",
    "dev": "eve dev",
    "start": "eve start",
    "init-vault": "node scripts/init-vault.mjs",
    "replica": "node scripts/replica-smoke.ts",
    "live-turn": "node scripts/live-turn.ts",
    "poll": "node --env-file=.env scripts/telegram-poll.mjs",
    "memory": "node --env-file=.env scripts/memory/night.ts",
    "cleanup": "node scripts/vault-cleanup.ts",
    "brain": "node --env-file=.env scripts/memory/brain.ts",
    "doctor": "npm run brain",
    "typecheck": "tsgo",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "lint:fix": "eslint --flag unstable_native_nodejs_ts_config . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --test --test-concurrency=4 \"agent/**/*.test.ts\" \"scripts/**/*.test.ts\" \"services/**/*.test.ts\"",
    "test:coverage": "node --test --test-concurrency=4 --experimental-test-coverage --test-coverage-include=\"agent/**/*.ts\" --test-coverage-include=\"scripts/**/*.ts\" --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-exclude=\"scripts/fixtures/**/*.ts\" --test-coverage-lines=75 --test-coverage-branches=77 --test-coverage-functions=71 \"agent/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:security": "node --test agent/lib/eve-auth.test.ts scripts/lib/assistant-auth.test.ts scripts/lib/listener-security.test.ts scripts/lib/security-migration.test.ts",
    "test:update-ui": "node --test scripts/lib/update-ui.test.ts scripts/lib/update-check.test.ts",
    "postinstall": "patch-package --error-on-fail"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.15",
    "@ai-sdk/openai-compatible": "^3.0.11",
    "@iva/context-window": "file:packages/context-window",
    "@iva/data-dir": "file:packages/data-dir",
    "@iva/timezone": "file:packages/timezone",
    "@iva/vault-dir": "file:packages/vault-dir",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ai": "^7.0.82",
    "croner": "10.0.1",
    "eve": "0.51.1",
    "just-bash": "^3.0.0",
    "zod": "4.5.4",
    "@iva/opencode-protocol": "file:packages/opencode-protocol"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.x",
    "@typescript/native-preview": "7.0.0-dev.20260523.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "4.9.0",
    "globals": "^17.9.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "engines": {
    "node": "24.x"
  }
}
