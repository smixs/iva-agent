exports[`Linux units, control argv and journal hints retain the release baseline 1`] = `
{
  "units": {
    "iva-brain.service": "[Unit]\\nDescription=Iva brain (nightly vault care: enforce, health, decay, MOC, git push)\\nAfter=network-online.target iva.service\\n\\n[Service]\\n# Everything these units create (vault, transcripts, data/) must not be world-readable.\\nUMask=0077\\nType=oneshot\\nWorkingDirectory=<fixture>/iva\\nEnvironmentFile=<fixture>/iva/.env\\nEnvironment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin\\n# Один флок на все memory-юниты: роллапы и brain пишут CORE.md/MOC.md — параллельный\\n# запуск (1 января стартуют все четыре) не должен переписывать их одновременно.\\n# Страховка от молчаливого зависания хода (#104): убитый по таймауту юнит становится\\n# failed и виден в \`iva doctor\`.\\n# Именно TimeoutStartSec, а не RuntimeMaxSec: у Type=oneshot последний игнорируется\\n# (systemd-analyze verify: «has no effect in combination with Type=oneshot»), а свой\\n# таймаут старта у oneshot по умолчанию вовсе отключён.\\nTimeoutStartSec=3600\\n# -w (сколько ждать лок) держим ВЫШЕ TimeoutStartSec: роллапы занимают тот же лок на\\n# час, и короткое ожидание превращало «brain подождал» в «brain не запускался этой\\n# ночью». Раньше кончится TimeoutStartSec — юнит станет failed и попадёт в \`iva doctor\`.\\nExecStart=/usr/bin/env \\"ASSISTANT_DATA_DIR=<fixture>/iva/data\\" /usr/bin/flock -w 3900 <fixture>/iva/.memory.lock <node-bin>/node --env-file=.env scripts/memory/brain.ts\\n",
    "iva-brain.timer": "[Unit]\\nDescription=Iva brain (nightly) — ~05:00 local, after rollups\\n\\n[Timer]\\nOnCalendar=*-*-* 05:00:00 UTC\\nPersistent=true\\n\\n[Install]\\nWantedBy=timers.target\\n",
    "iva-telegram-poll.service": "# systemd USER unit — Telegram polling-мост (бот отвечает без webhook/прокси).\\n#\\n# Сам забирает апдейты у Telegram (getUpdates) и POST-ит их в локальный eve.\\n# Плейсхолдеры <fixture>/iva/<node-bin>/node подставляет install.sh.\\n# Установка вручную: см. комментарии в deploy/iva-memory-daily.service.\\n[Unit]\\nDescription=Iva Telegram polling bridge (getUpdates → local webhook)\\nAfter=network-online.target iva.service\\nWants=iva.service\\n\\n[Service]\\n# Everything these units create (vault, transcripts, data/) must not be world-readable.\\nUMask=0077\\nWorkingDirectory=<fixture>/iva\\nEnvironmentFile=<fixture>/iva/.env\\nEnvironment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin\\nExecStart=/usr/bin/env \\"ASSISTANT_DATA_DIR=<fixture>/iva/data\\" <node-bin>/node --env-file=.env scripts/telegram-poll.mjs\\n# Bootstrap units introduced by an update: the updater that fetched this file may still\\n# be running the previous CLI code and therefore cannot know about the new timer yet.\\nExecStartPost=-/usr/bin/systemctl --user enable --now iva-update-check.timer\\nRestart=always\\nRestartSec=3\\n\\n[Install]\\nWantedBy=default.target\\n",
    "iva-telegram-userbot.service": "# systemd USER unit — Telegram userbot MCP-прокси (единственный владелец Telethon-сессии).\\n#\\n# Держит личный аккаунт владельца (userbot) и отдаёт его тулы по MCP streamable-HTTP\\n# на 127.0.0.1 для iva. Opt-in: юнит ПИШЕТСЯ всегда, но включается только командой\\n# \`iva userbot setup\` (она же собирает venv и генерирует токен). Без TELEGRAM_API_ID/HASH\\n# в .env serve.py завершится с понятной ошибкой — поэтому не в авто-enable списке.\\n#\\n# Плейсхолдеры <fixture>/iva, <fixture>/iva/services/telegram-userbot/.venv/bin/python и \\"ASSISTANT_DATA_DIR=<fixture>/iva/data\\" подставляет writeUnits()\\n# (scripts/cli/systemd.ts; bin/iva.mjs остаётся внешним entry shim).\\n[Unit]\\nDescription=Iva Telegram userbot MCP proxy (Telethon session owner)\\nAfter=network-online.target iva.service\\nWants=iva.service\\n\\n[Service]\\nWorkingDirectory=<fixture>/iva/services/telegram-userbot\\nEnvironmentFile=<fixture>/iva/.env\\nEnvironment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin\\n# The SQLite session holds the MTProto auth key — keep everything the proxy writes private.\\nUMask=0077\\n# Apply this after EnvironmentFile, so its raw relative value cannot win.\\nExecStart=/usr/bin/env \\"ASSISTANT_DATA_DIR=<fixture>/iva/data\\" <fixture>/iva/services/telegram-userbot/.venv/bin/python serve.py\\nRestart=always\\nRestartSec=5\\n\\n[Install]\\nWantedBy=default.target\\n",
    "iva-update-check.service": "[Unit]\\nDescription=Iva daily update check\\nAfter=network-online.target\\nWants=network-online.target\\n\\n[Service]\\n# Everything these units create (vault, transcripts, data/) must not be world-readable.\\nUMask=0077\\nType=oneshot\\nWorkingDirectory=<fixture>/iva\\nEnvironmentFile=<fixture>/iva/.env\\nEnvironment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin\\nExecStart=/usr/bin/env \\"ASSISTANT_DATA_DIR=<fixture>/iva/data\\" <node-bin>/node --env-file=.env scripts/check-update.mjs\\n",
    "iva-update-check.timer": "[Unit]\\nDescription=Iva daily update check — 10:00 local\\n\\n[Timer]\\nOnCalendar=*-*-* 10:00:00 UTC\\nPersistent=true\\n\\n[Install]\\nWantedBy=timers.target\\n",
    "iva.service": "[Unit]\\nDescription=Iva\\nAfter=network-online.target\\n\\n[Service]\\nUMask=0077\\nOOMPolicy=continue\\nKillMode=control-group\\nWorkingDirectory=<fixture>/iva\\nEnvironmentFile=<fixture>/iva/.env\\nExecStartPre=-/usr/bin/env \\"ASSISTANT_DATA_DIR=<fixture>/iva/data\\" <node-bin>/node <fixture>/iva/scripts/recover-interrupted-turns.ts\\nExecStart=/usr/bin/env \\"ASSISTANT_DATA_DIR=<fixture>/iva/data\\" <node-bin>/node <fixture>/iva/node_modules/eve/bin/eve.js start --host 127.0.0.1\\nEnvironment=PORT=8723\\nEnvironment=TZ=UTC\\nEnvironment=PATH=%h/.local/bin:<node-bin>:/usr/local/bin:/usr/bin:/bin\\nEnvironment=AGENT_BROWSER_MAX_OUTPUT=24000\\nEnvironment=WORKFLOW_LOCAL_HEADERS_TIMEOUT_MS=3600000\\nEnvironment=WORKFLOW_LOCAL_BODY_TIMEOUT_MS=3600000\\nRestart=always\\n\\n[Install]\\nWantedBy=default.target\\n"
  },
