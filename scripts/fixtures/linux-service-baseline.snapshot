exports[`Linux plugin unit bodies and failure hints retain the release baseline 1`] = `
{
  "proxy": "[Unit]\\nDescription=Iva MCP proxy for example/stdio\\nAfter=network-online.target\\n\\n[Service]\\nUMask=0077\\nWorkingDirectory=/fixture/iva/current\\nExecStart=/usr/bin/env \\"ASSISTANT_DATA_DIR=/fixture/iva/data\\" \\"/fixture/node-bin/node\\" \\"/fixture/iva/current/services/mcp-proxy/serve.ts\\" --plugin \\"example\\" --server \\"stdio\\" --port 12345 --token-file \\"/fixture/iva/data/proxy.token\\"\\nEnvironment=\\"PATH=%h/.local/bin:/fixture/node-bin:/usr/local/bin:/usr/bin:/bin\\"\\nRestart=on-failure\\nRestartSec=5\\n\\n[Install]\\nWantedBy=default.target\\n",
  "service": "[Unit]\\nDescription=Iva plugin service example/web\\nAfter=network-online.target\\n\\n[Service]\\nUMask=0077\\nWorkingDirectory=/fixture/iva/data/custom/plugins/example/sh.iva/services/web\\nExecStart=/usr/bin/env \\"node\\" \\"serve.ts\\" \\"a b\\" \\"$$value\\" \\"50%%\\" \\"<&\\\\\\"\\\\\\\\ю>\\"\\nEnvironment=\\"IVA_SERVICE_PORT=12346\\"\\nEnvironment=\\"IVA_DATA_DIR=/fixture/iva/data\\"\\nEnvironment=\\"PLUGIN_ROOT=/fixture/iva/data/custom/plugins/example\\"\\nEnvironment=\\"PLUGIN_DATA=/fixture/iva/data/plugins/example\\"\\nEnvironment=\\"PATH=%h/.local/bin:/fixture/node-bin:/usr/local/bin:/usr/bin:/bin\\"\\nRestart=on-failure\\nRestartSec=5\\n\\n[Install]\\nWantedBy=default.target\\n",
  "hints": [
    "failed (exit 7). Check: journalctl --user -u iva.service -n 100 --no-pager",
    "failed (exit 7). Check: journalctl --user -u iva-telegram-poll.service -n 100 --no-pager",
    "failed (exit 7). Check: journalctl --user -u iva-brain.service -n 100 --no-pager",
