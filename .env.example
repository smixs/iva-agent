# Язык ответов агента: en | ru (выбирается в `npm run setup`, дефолт ru).
# Управляет инструкцией 05-language, локалью даты (now) и сидом CORE при init-vault.
AGENT_LANGUAGE=ru

# Провайдер модели: ollama | opencode | openrouter | codex | claude | custom | requesty.
#   ollama/opencode/openrouter — OpenAI-совместимы (chat/completions), статичный API-ключ ниже.
#   codex — личная подписка OpenAI (ChatGPT): Responses API + OAuth, ключ НЕ нужен (см. ниже).
#   claude — подписка Claude Pro/Max: Ива зовёт CLI claude на этом же сервере, ключ НЕ нужен.
#   custom — свой OpenAI-совместимый эндпоинт: адрес задаёшь сам (см. блок CUSTOM_* ниже).
MODEL_PROVIDER=ollama

# Ollama Cloud (если MODEL_PROVIDER=ollama)
OLLAMA_API_KEY=ollama-...
OLLAMA_MODEL=deepseek-v4-pro
# Модель, которой описывается входящее фото (пусто = дефолт; codex смотрит текстовой моделью).
OLLAMA_VISION_MODEL=gemma4:31b
# Окно контекста: НЕ завышай — компактация считает порог от него (overflow-риск).
OLLAMA_CONTEXT_WINDOW=131072

# OpenCode Go, экс-Zen (если MODEL_PROVIDER=opencode) — https://opencode.ai/auth
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4-pro
OPENCODE_VISION_MODEL=qwen3.7-plus
OPENCODE_CONTEXT_WINDOW=131072

# OpenRouter (если MODEL_PROVIDER=openrouter) — один ключ на 300+ моделей.
# Ключ: https://openrouter.ai/keys. Слаг модели скопируй с https://openrouter.ai/models
# в виде vendor/model (напр. anthropic/claude-sonnet-4.5). `iva config` проверит его живым запросом.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.1
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
# Окно контекста — впиши реальное окно выбранной модели (компактация считает порог от него).
OPENROUTER_CONTEXT_WINDOW=131072

# Requesty (если MODEL_PROVIDER=requesty): OpenAI-совместимый шлюз, один ключ на 700+ моделей.
# Ключ: https://app.requesty.ai/api-keys. Id модели с https://www.requesty.ai/models: managed policy
# (напр. gpt-5.5, для EU-маршрутизации gpt-5-mini@eu) или vendor/model (напр. openai/gpt-4o-mini).
# `iva config` проверит его живым запросом.
REQUESTY_API_KEY=
REQUESTY_MODEL=gpt-5.5
REQUESTY_VISION_MODEL=gemini-3.5-flash
# Окно контекста: впиши реальное окно выбранной модели (компактация считает порог от него).
REQUESTY_CONTEXT_WINDOW=131072

# OpenAI по подписке ChatGPT (если MODEL_PROVIDER=codex). Вход: `iva login`
# (по ссылке+коду) или `iva login --browser`. Токен → data/codex-auth.json (0600, не в .env).
# API-ключ НЕ нужен. Модель выбирается в `iva config` из реального списка подписки.
CODEX_MODEL=gpt-5.5
CODEX_CONTEXT_WINDOW=272000

# Claude по подписке Pro/Max (если MODEL_PROVIDER=claude). Ключа нет: CLI claude должен
# быть установлен и залогинен на этом же сервере один раз —
# `npm install -g --prefix ~/.local @anthropic-ai/claude-code` (под пользователем сервиса,
# без root: бинарь ляжет в ~/.local/bin из PATH сервиса), затем `claude auth login`.
# Модель выбирается в `iva config`: Fable 5.1, Opus 5 или Sonnet 5.
# Окно контекста у этих трёх — 1000000.
CLAUDE_MODEL=claude-fable-5-1
CLAUDE_CONTEXT_WINDOW=1000000
# CLAUDE_COMMAND — путь к бинарю CLI, если его нет в PATH сервиса. Обычно не нужен.
# CLAUDE_COMMAND=
# CLAUDE_SESSION_CWD — все шаги одного диалога CLI идут в одной приватной папке, чтобы кэш
# промпта не писал историю заново. off возвращает временную папку на каждый шаг.
# CLAUDE_SESSION_CWD=off

# Свой OpenAI-совместимый эндпоинт (если MODEL_PROVIDER=custom): чужой прокси, vLLM,
# LiteLLM, вендорская подписка. Адрес и модель Ива не угадывает — обе строки обязательны,
# пустая валит старт с именем переменной.
# CUSTOM_BASE_URL — база ЦЕЛИКОМ, вместе с суффиксом вида /v1 (как у ollama.com/v1).
CUSTOM_BASE_URL=
# CUSTOM_API_KEY — необязателен: свой сервер без авторизации живёт пустым, тогда
# заголовок Authorization не отправляется вовсе.
CUSTOM_API_KEY=
CUSTOM_MODEL=
# Vision-модель — запасной путь: модель чата, которая сама видит картинки, спрашивается
# напрямую (см. *_VISION_MODEL выше). Пусто = картинку смотрит выбранная текстовая модель.
CUSTOM_VISION_MODEL=
CUSTOM_CONTEXT_WINDOW=131072
# CUSTOM_REASONING=1 — эндпоинт понимает reasoning_effort (Meta Model API, vLLM с
# reasoning-моделью): Ива шлёт ему THINKING_EFFORT. Пусто = не шлём, чужой сервер
# на незнакомое поле может ответить 400.
CUSTOM_REASONING=

# Reasoning-усилие модели: minimal | low | medium | high | xhigh | max (пусто = не задано).
# Пишется командами /model и /think в Telegram, не руками. Нативно применяется на codex;
# ollama/opencode шлют по OpenAI-совместимому проводу только low/medium/high, остальное игнорируют;
# openrouter, requesty и custom в визарде сносят эту строку, вписанное руками значение там игнорируется
# (чужой эндпоинт reasoning_effort не обещал, и лишнее поле — риск HTTP 400 на каждом ходу).
THINKING_EFFORT=

# Браузер agent-browser: потолок вывода (защита окна контекста).
AGENT_BROWSER_MAX_OUTPUT=24000

# Telegram-бот (для канала и дайджеста)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_BOT_USERNAME=my_bot
TELEGRAM_WEBHOOK_SECRET_TOKEN=придумай_длинную_строку
# БЕЗОПАСНОСТЬ: бот отвечает ТОЛЬКО этим user ID (через запятую). Пусто = не отвечает никому.
# Свой ID: напиши @userinfobot или запусти `npm run setup` (автоопределение).
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_DIGEST_CHAT_ID=         # твой chat_id для утреннего дайджеста
# Порог replay перед завершением Telegram-сессии, миллисекунды (по умолчанию 30000).
# TELEGRAM_REPLAY_RETIRE_THRESHOLD_MS=30000

# Группа поддержки: ссылка-приглашение в Telegram, куда Иве предложить прийти с описанием
# проблемы (скилл report-problem). Пусто = Ива честно скажет, что адрес не настроен.
SUPPORT_CHAT_URL=

# Telegram userbot (opt-in) — доступ к ЛИЧНОМУ аккаунту через Telethon. НА СВОЙ СТРАХ И РИСК
# (риск бана аккаунта). Настраивать РУКАМИ не нужно: просто напиши боту «подключи мой телеграм» —
# агент сам заведёт приложение на my.telegram.org, впишет api_id/api_hash сюда (через
# `iva userbot creds`), поднимет прокси и покажет QR. Токен прокси хранится в файле
# data/telegram-userbot.token (не здесь). Ключи агент запишет сам:
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_MCP_PORT=8724          # порт прокси на 127.0.0.1 (дефолт 8724)
# TELEGRAM_USERBOT_QR_CHAT_ID=    # куда слать QR (по умолчанию — первый из TELEGRAM_ALLOWED_USER_IDS)
# TELEGRAM_EXPOSED_TOOLS=all      # all | read-only (read-only = агент только читает, без отправки)

# Deepgram — транскрипция голоса/видео из Telegram (nova-3)
# Ключ: https://console.deepgram.com → API Keys
DEEPGRAM_API_KEY=
# Язык распознавания. multi = автоопределение (ru/uz/en и др.).
DEEPGRAM_LANGUAGE=multi

# Веб-поиск — инструмент web_search. Выбери провайдера и впиши его ключ.
# Без ключа выбранного провайдера поиск не работает (DuckDuckGo с серверного IP даёт капчу).
#   tavily   https://app.tavily.com                  free ~1000/мес, без карты, есть answer (рекомендуем)
#   exa      https://dashboard.exa.ai                free ~20k/мес, без карты
#   parallel https://platform.parallel.ai            стартовые кредиты, без карты
#   brave    https://api-dashboard.search.brave.com  нужна карта (идентификация), ~$5/мес кредит
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=
PARALLEL_API_KEY=

# Поиск по памяти (memory_search). По умолчанию grep = встроенный BM25 (node:sqlite FTS5) +
# близость по графу связей — ноль зависимостей, ноль внешних ключей, работает на $4-боксе.
#   hybrid = дополнительно dense-эмбеддинги (RRF-слияние с BM25) через ОДИН внешний ключ.
# Для hybrid задай ОДИН ключ (Jina — no-train/EU/дёшево, или DeepInfra — дешевле, BGE-M3),
# индекс собирает ночной проход Brain (или вручную: node --env-file=.env scripts/memory/embed-index.ts).
MEMORY_SEARCH_MODE=grep
JINA_API_KEY=
DEEPINFRA_API_KEY=
# MEMORY_EMBED_PROVIDER=jina        # переопределить автовыбор (jina|deepinfra)
# MEMORY_EMBED_MODEL=jina-embeddings-v3
# MEMORY_EMBED_URL=http://127.0.0.1:11434/v1/embeddings  # любой OpenAI-совместимый эндпоинт
#                                   # (напр. локальный Ollama) — тогда внешний ключ не нужен

# Часовой пояс (IANA). Используется для дат daily-транскрипта, систем­ных
# таймеров памяти и динамической инструкции now. Пробрасывается в TZ.
ASSISTANT_TIMEZONE=Asia/Almaty

# Каталог ЖИВОГО vault (память + Obsidian + git-бэкап). Относительный или абсолютный.
# Отдельный приватный git-репо; создаётся из vault-template/ через `npm run init-vault`.
ASSISTANT_VAULT_DIR=vault

# Хранилище задач (необязательно; по умолчанию ./data)
ASSISTANT_DATA_DIR=data

# Порт локального eve-сервера. Дефолт 8723 — непопсовый: 3000/8000/8080 на типовом
# VPS обычно заняты (docker и пр.). Сервер слушает его, клиенты ходят на него же.
IVA_PORT=8723

# Куда ходят cron/poll-клиенты (необязательно; по умолчанию http://127.0.0.1:${IVA_PORT})
ASSISTANT_HOST=http://127.0.0.1:8723
# Генерируется setup/upgrade; общий секрет локальных Eve-клиентов. Не публиковать.
# ASSISTANT_BEARER=
