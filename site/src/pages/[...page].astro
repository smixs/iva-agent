---
import { getCollection, render } from "astro:content";
import { readFileSync, existsSync } from "node:fs";
import path from "node:path";
import Base from "../layouts/Base.astro";
import { docUrl } from "../lib/doc-links";
import type { Lang } from "../lib/copy";
import {
  breadcrumbs,
  clip,
  markdownDescription,
  organization,
  pageTitle,
  plainMarkdown,
  textLang,
} from "../lib/seo";
// Folders of the docs without a README of their own get a contents page with this name.
const folders: Record<string, string> = {
  adr: "Architecture decision records (ADR)",
};
// The H1 of a doc, as plain text: link names on contents pages, breadcrumbs, titles.
const headingOf = (id: string) =>
  plainMarkdown(
    readFileSync(path.resolve("../docs", id + ".md"), "utf8").match(/^# (.+)$/m)?.[1] || id.split("/").at(-1)!,
  );
export async function getStaticPaths() {
  const entries = await getCollection("docs");
  const routes = entries.map((entry) => ({
    params: { page: docUrl(entry.id + ".md").slice(1, -1) },
    props: { entry },
  }));
  const directories = new Set(
    entries
      .filter((e) => e.id.includes("/") && !e.id.startsWith("ru/"))
      .map((e) => e.id.slice(0, e.id.lastIndexOf("/"))),
  );
  for (const directory of directories)
    if (!entries.some((e) => e.id === directory + "/README"))
      routes.push({
        params: { page: "docs/" + directory },
        props: {
          directory,
          entries: entries.filter((e) => e.id.startsWith(directory + "/")),
        },
      } as any);
  return [
    ...routes,
    ...["about", "ru/about", "privacy"].map((page) => ({
      params: { page },
      props: { staticPage: page },
    })),
  ];
}
const { entry, directory, entries, staticPage } = Astro.props;
const lang: Lang =
  entry?.id.startsWith("ru/") || staticPage === "ru/about" ? "ru" : "en";
let html = "",
  title = "",
  description = "",
  contentLang: Lang | undefined,
  Content;
if (staticPage) {
  const file =
    staticPage === "privacy"
      ? "privacy"
      : lang === "ru"
        ? "about-ru"
        : "about-en";
  html = readFileSync(path.resolve(`src/data/${file}.html`), "utf8");
  if (staticPage !== "privacy")
    html = html.replace(
      /<a\b[^>]*href="https:\/\/majento.ai\/(?:ru\/)?ai-implementation\/[^"]*"[^>]*>[\s\S]*?<\/a\s*>/,
      `<a class="button secondary" href="https://majento.ai/ai-implementation/?utm_source=iva-agent.com&amp;utm_medium=referral&amp;utm_campaign=ecosystem">${lang === "ru" ? "Обсудить внедрение с Majento" : "Discuss an implementation with Majento"}</a>`,
    );
  title = html.match(/<h1>(.*?)<\/h1>/s)?.[1] || "Iva";
  description = clip(
    plainMarkdown(html.match(/<p>\s*([\s\S]*?)<\/p>/)?.[1] || title),
  );
} else if (entry) {
  ({ Content } = await render(entry));
  const source = readFileSync(
    path.resolve("../docs", entry.id + ".md"),
    "utf8",
  );
  title = headingOf(entry.id);
  contentLang = textLang(source);
  description = markdownDescription(
    source,
    contentLang === "ru" ? `${title}: документация Ивы.` : `${title}: Iva documentation.`,
  );
} else {
  title = folders[directory] || directory;
  description = clip(
    `${title} of Iva: ${entries.length} pages on how the assistant is built, each decision with the alternatives it rejected.`,
  );
}
const slug = entry?.id.replace(/^ru\//, "");
const enPath = staticPage
  ? staticPage === "ru/about"
    ? "/about/"
    : "/" + staticPage + "/"
  : entry
    ? docUrl(slug + ".md")
    : Astro.url.pathname;
const hasRu = entry && existsSync(path.resolve("../docs/ru", slug + ".md"));
const ruPath = staticPage
  ? staticPage === "privacy"
    ? "/privacy/"
    : "/ru/about/"
  : hasRu
    ? docUrl("ru/" + slug + ".md")
    : "/ru/docs/";
const crumbs = [
  {
    name: lang === "ru" ? "Главная" : "Home",
    url: lang === "ru" ? "/ru/" : "/",
  },
  {
    name: lang === "ru" ? "Документация" : "Documentation",
    url: lang === "ru" ? "/ru/docs/" : "/docs/",
  },
];
if (directory) crumbs.push({ name: title, url: Astro.url.pathname });
else if (entry && !entry.id.endsWith("README"))
  crumbs.push({ name: title, url: Astro.url.pathname });
const schema =
  entry || directory
    ? [breadcrumbs(crumbs)]
    : staticPage && staticPage !== "privacy"
      ? [organization(lang)]
      : [];
---

<Base
  title={pageTitle(title, contentLang || lang, Boolean(entry || directory))}
  description={description}
  lang={lang}
  en={enPath}
  ru={ruPath}
  schema={schema}
  ruAlternate={Boolean(hasRu) || (Boolean(staticPage) && staticPage !== "privacy")}
  contentLang={contentLang}
>
  <article class="section prose" lang={contentLang && contentLang !== lang ? contentLang : undefined}>
    {(entry || directory) && (
      <nav
        class="breadcrumbs"
        aria-label={lang === "ru" ? "Хлебные крошки" : "Breadcrumbs"}
      >
        {crumbs.map((c, i) => (
          <>
            <span aria-hidden="true">{i > 0 ? " / " : ""}</span>
            <a
              href={c.url}
              aria-current={i === crumbs.length - 1 ? "page" : undefined}
            >
              {c.name}
            </a>
          </>
        ))}
      </nav>
    )}
    {staticPage && staticPage !== "privacy" && (
      <>
        <a class="back" href={lang === "ru" ? "/ru/" : "/"}>
          {lang === "ru" ? "← Вернуться к Иве" : "← Back to Iva"}
        </a>
        <div class="actions about-links">
          <a href={lang === "ru" ? "/ru/docs/" : "/docs/"}>
            {lang === "ru" ? "Документация Ивы" : "Iva docs"}
          </a>
          <a href="https://github.com/smixs/iva-agent">GitHub</a>
        </div>
      </>
    )}
    {staticPage ? (
      <Fragment set:html={html} />
    ) : entry ? (
      Content && <Content />
    ) : (
      <>
        <h1>{title}</h1>
        <ul>
          {entries.map((e: any) => (
            <li>
              <a href={docUrl(e.id + ".md")}>{headingOf(e.id)}</a>
            </li>
          ))}
        </ul>
      </>
    )}
    {entry && (
      <a class="raw" href={"/" + entry.id + ".md"}>
        {lang === "ru" ? "Исходный Markdown" : "View original Markdown"} ↗
      </a>
    )}
  </article>
</Base>
