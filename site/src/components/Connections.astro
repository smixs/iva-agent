---
// Verified services, using the existing official and Simple Icons marks.
import type { Lang } from "../lib/copy";
const { lang, title, line, link } = Astro.props as {
  lang: Lang;
  title: string;
  line: string;
  link: string;
};
const svg = import.meta.glob<string>("../assets/logos/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});
const mark = (id: string) => svg[`../assets/logos/${id}.svg`];
const ru = lang === "ru";
const items = [
  ["gmail", "Gmail"],
  ["googlecalendar", ru ? "Google Календарь" : "Google Calendar"],
  ["googledrive", "Google Drive"],
  ["notion", "Notion"],
  ["slack", "Slack"],
  ["github", "GitHub"],
  ["todoist", "Todoist"],
  ["obsidian", "Obsidian"],
];
---

<section id="connections" class="section connections" aria-labelledby="connections-title">
  <div class="connections-copy">
    <h2 id="connections-title">{title}</h2>
    {line && <p>{line}</p>}
    <a class="text-link" href={ru ? "/ru/docs/" : "/docs/extending/"}>{link}</a>
  </div>
  <ul class="connection-list">
    {items.map(([id, name]) => (
      <li>
        <span class="connection-mark" aria-hidden="true" set:html={mark(id)} />
        <span>{name}</span>
      </li>
    ))}
  </ul>
</section>
