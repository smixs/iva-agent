---
// Mail, calendar and the built-in browser first, then services people connect; the last tile
// says that any other service connects the same way.
import type { Lang } from "../lib/copy";
import { marks, wide } from "../lib/services";
const { lang, title, line, link } = Astro.props as {
  lang: Lang;
  title: string;
  line: string;
  link: string;
};
const ru = lang === "ru";
const items = [
  ["mail", ru ? "Почта" : "Mail"],
  ["googlecalendar", ru ? "Календарь" : "Calendar"],
  ["browser", ru ? "Браузер" : "Browser"],
  ["googledrive", "Google Drive"],
  ["notion", "Notion"],
  ["slack", "Slack"],
  ["github", "GitHub"],
  ["todoist", "Todoist"],
  ["obsidian", "Obsidian"],
  ["bitrix24", ru ? "Битрикс24" : "Bitrix24"],
  ["1c", ru ? "1С" : "1C"],
  ["more", ru ? "Любые ваши" : "Any of yours"],
];
---

<section id="connections" class="section connections" aria-labelledby="connections-title">
  <div class="connections-copy">
    <h2 id="connections-title">{title}</h2>
    {line && <p>{line}</p>}
    <a class="text-link" href={ru ? "/ru/docs/" : "/docs/extending/"}>{link}</a>
  </div>
  <ul class="connection-list">
    {items.map(([id, name]) => (
      <li>
        <span class:list={["connection-mark", wide.has(id) && "is-wide"]} aria-hidden="true" style={`--tile:${marks[id][1]};--mark:${marks[id][2]}`}><svg><use href={`/services.svg#${id}`} /></svg></span>
        <span>{name}</span>
      </li>
    ))}
  </ul>
</section>
