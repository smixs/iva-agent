---
// Front-facing phone from the demo film (V6): ~/dev/tries/2026-10-22-iva-demo-film/src/components/Phone.tsx,
// with an iPhone-tall body (1 : 2.05). Every size is N * var(--pt), so the numbers match the film tokens.
const { time = "8:25" } = Astro.props as { time?: string };
---

<div class="phone">
  <span class="phone-btn" style="--top:186;--h:20;--side:l"></span>
  <span class="phone-btn" style="--top:259;--h:47;--side:l"></span>
  <span class="phone-btn" style="--top:343;--h:47;--side:l"></span>
  <span class="phone-btn is-right" style="--top:283;--h:105"></span>
  <div class="phone-rim">
    <div class="phone-screen">
      <slot />
      <div class="phone-status" aria-hidden="true">
        <span class="phone-time">{time}</span>
        <span class="phone-icons">
          <svg viewBox="0 0 31 20" class="i-signal">
            {[0, 1, 2, 3].map((i) => (
              <rect
                x={i * 8.3}
                y={20 - (6 + i * 4.6)}
                width="5.6"
                height={6 + i * 4.6}
                rx="1.6"
              />
            ))}
          </svg>
          <svg viewBox="0 0 28 20" class="i-wifi">
            <path d="M14 3.2c4.4 0 8.4 1.7 11.4 4.5.4.4.4 1 0 1.4l-1.6 1.6c-.4.4-1 .4-1.4 0A12 12 0 0 0 14 7.4c-3.2 0-6.2 1.3-8.4 3.3-.4.4-1 .4-1.4 0L2.6 9.1c-.4-.4-.4-1 0-1.4C5.6 4.9 9.6 3.2 14 3.2z" />
            <path d="M14 9.6c2.6 0 5 1 6.8 2.6.4.4.4 1 0 1.4l-1.6 1.6c-.4.4-1 .4-1.4 0A6 6 0 0 0 14 13.8c-1.5 0-2.8.5-3.8 1.4-.4.4-1 .4-1.4 0l-1.6-1.6c-.4-.4-.4-1 0-1.4A10 10 0 0 1 14 9.6z" />
            <path d="M14 16.1c.9 0 1.7.3 2.3.9.3.3.3.8 0 1.1l-1.6 1.6c-.4.4-1 .4-1.4 0l-1.6-1.6c-.3-.3-.3-.8 0-1.1.6-.6 1.4-.9 2.3-.9z" />
          </svg>
          <svg viewBox="0 0 42 20" class="i-battery">
            <rect
              x="1"
              y="1.5"
              width="35"
              height="17"
              rx="5.2"
              fill="none"
              stroke="currentColor"
              stroke-opacity=".4"
              stroke-width="2"></rect>
            <rect x="3.6" y="4.1" width="29.8" height="11.8" rx="3"></rect>
            <path
              d="M38.6 7.2c1.4.4 2.3 1.6 2.3 2.8s-.9 2.4-2.3 2.8z"
              fill-opacity=".45"></path>
          </svg>
        </span>
      </div>
      <span class="phone-island" aria-hidden="true"><i></i></span>
      <span class="phone-home" aria-hidden="true"></span>
    </div>
  </div>
</div>
