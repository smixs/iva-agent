---
// V6's front-facing titanium frame, status icons, island and home indicator.
// 434 × 890 pt is the film's full-height adaptation; every interior coordinate is in pt.
const { time = "9:41" } = Astro.props as { time?: string };
---
<div class="v7-device">
  <div class="v7-phone">
    <span class="v7-side" style="--top:186;--h:20"></span>
    <span class="v7-side" style="--top:259;--h:47"></span>
    <span class="v7-side" style="--top:343;--h:47"></span>
    <span class="v7-side is-right" style="--top:283;--h:105"></span>
    <div class="v7-body-clip">
    <div class="v7-rim">
      <div class="v7-phone-screen">
        <slot />
        <div class="v7-status" aria-hidden="true">
          <span class="v7-clock" data-demo-clock>{time}</span>
          <span class="v7-status-icons">
            <svg viewBox="0 0 31 20" class="signal">
              {[0, 1, 2, 3].map((i) => <rect x={i * 8.3} y={20 - (6 + i * 4.6)} width="5.6" height={6 + i * 4.6} rx="1.6" />)}
            </svg>
            <svg viewBox="0 0 28 20" class="wifi">
              <path d="M14 3.2c4.4 0 8.4 1.7 11.4 4.5.4.4.4 1 0 1.4l-1.6 1.6c-.4.4-1 .4-1.4 0A12 12 0 0 0 14 7.4c-3.2 0-6.2 1.3-8.4 3.3-.4.4-1 .4-1.4 0L2.6 9.1c-.4-.4-.4-1 0-1.4C5.6 4.9 9.6 3.2 14 3.2z" />
              <path d="M14 9.6c2.6 0 5 1 6.8 2.6.4.4.4 1 0 1.4l-1.6 1.6c-.4.4-1 .4-1.4 0A6 6 0 0 0 14 13.8c-1.5 0-2.8.5-3.8 1.4-.4.4-1 .4-1.4 0l-1.6-1.6c-.4-.4-.4-1 0-1.4A10 10 0 0 1 14 9.6z" />
              <path d="M14 16.1c.9 0 1.7.3 2.3.9.3.3.3.8 0 1.1l-1.6 1.6c-.4.4-1 .4-1.4 0l-1.6-1.6c-.3-.3-.3-.8 0-1.1.6-.6 1.4-.9 2.3-.9z" />
            </svg>
            <svg viewBox="0 0 42 20" class="battery">
              <rect x="1" y="1.5" width="35" height="17" rx="5.2" fill="none" stroke="currentColor" stroke-opacity=".4" stroke-width="2" />
              <rect x="3.6" y="4.1" width="29.8" height="11.8" rx="3" />
              <path d="M38.6 7.2c1.4.4 2.3 1.6 2.3 2.8s-.9 2.4-2.3 2.8z" fill-opacity=".45" />
            </svg>
          </span>
        </div>
        <span class="v7-island" aria-hidden="true"><i></i></span>
        <span class="v7-home" aria-hidden="true"></span>
      </div>
    </div>
    </div>
  </div>
</div>
<style>
  /* V6 fonts.ts subsets; unique families keep the marketing page typography intact. */
  @font-face { font-family:"V7IvaUI"; font-style:normal; font-weight:400; font-display:swap; src:url("/media/fonts/inter-latin-400-normal.woff2") format("woff2"); unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD; }
  @font-face { font-family:"V7IvaUI"; font-style:normal; font-weight:400; font-display:swap; src:url("/media/fonts/inter-cyrillic-400-normal.woff2") format("woff2"); unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116; }
  @font-face { font-family:"V7IvaUI"; font-style:normal; font-weight:600; font-display:swap; src:url("/media/fonts/inter-latin-600-normal.woff2") format("woff2"); unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD; }
  @font-face { font-family:"V7IvaUI"; font-style:normal; font-weight:600; font-display:swap; src:url("/media/fonts/inter-cyrillic-600-normal.woff2") format("woff2"); unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116; }
  @font-face { font-family:"V7IvaSerif"; font-style:normal; font-weight:400; font-display:swap; src:url("/media/fonts/source-serif-4-latin-400-normal.woff2") format("woff2"); unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD; }
  @font-face { font-family:"V7IvaSerif"; font-style:normal; font-weight:400; font-display:swap; src:url("/media/fonts/source-serif-4-cyrillic-400-normal.woff2") format("woff2"); unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116; }
  .v7-device { width:100%; container-type:inline-size; }
  .v7-phone { --vp:calc(100cqw / 434); position:relative; width:100%; height:calc(890 * var(--vp)); border-radius:calc(73.3 * var(--vp)); background:linear-gradient(90deg,#7d958b 0%,#3a4c45 1.6%,#22302b 4%,#2e3e38 30%,#34463f 50%,#2e3e38 70%,#22302b 96%,#3a4c45 98.4%,#7d958b 100%); box-shadow:inset 0 0 0 .5px #ffffff29,inset 0 1px 1.3px #ffffff38,0 calc(15 * var(--vp)) calc(37 * var(--vp)) #09221c4d,0 calc(2.7 * var(--vp)) calc(8 * var(--vp)) #09221c2e; }
  .v7-side { position:absolute; left:calc(-2.3 * var(--vp)); top:calc(var(--top) * var(--vp)); width:calc(3.3 * var(--vp)); height:calc(var(--h) * var(--vp)); border-radius:calc(1.3 * var(--vp)); background:linear-gradient(90deg,#22302b,#4b5f57 50%,#22302b); }
  .v7-side.is-right { left:auto; right:calc(-2.3 * var(--vp)); }
  .v7-body-clip { position:absolute; inset:0; border-radius:inherit; overflow:hidden; clip-path:inset(0 round calc(73.3 * var(--vp))); -webkit-mask-image:-webkit-radial-gradient(white,black); isolation:isolate; transform:translateZ(0); }
  .v7-rim { position:absolute; inset:calc(4.67 * var(--vp)); border-radius:calc(68.7 * var(--vp)); overflow:hidden; background:#050706; box-shadow:inset 0 0 0 1px #ffffff12; }
  .v7-phone-screen { position:absolute; left:calc(11.33 * var(--vp)); top:calc(11.33 * var(--vp)); width:calc(402 * var(--vp)); height:calc(858 * var(--vp)); border-radius:calc(57.3 * var(--vp)); overflow:hidden; clip-path:inset(0 round calc(57.3 * var(--vp))); -webkit-mask-image:-webkit-radial-gradient(white,black); transform:translateZ(0); background:#dfe6c9; isolation:isolate; font-family:"V7IvaUI","Apple Color Emoji",sans-serif; color:#17211d; }
  .v7-status { position:absolute; inset:0 0 auto; height:calc(54 * var(--vp)); z-index:6; pointer-events:none; }
  .v7-clock { position:absolute; left:calc(70 * var(--vp)); top:calc(33 * var(--vp)); transform:translate(-50%,-52%); font-weight:600; font-size:calc(18 * var(--vp)); letter-spacing:calc(-.2 * var(--vp)); font-variant-numeric:tabular-nums; }
  .v7-status-icons { position:absolute; right:calc(31 * var(--vp)); top:calc(33 * var(--vp)); transform:translateY(-50%); display:flex; align-items:center; gap:calc(6 * var(--vp)); fill:currentColor; }
  .signal { width:calc(17.8 * var(--vp)); height:calc(11.5 * var(--vp)); }
  .wifi { width:calc(16.8 * var(--vp)); height:calc(12 * var(--vp)); }
  .battery { width:calc(27.3 * var(--vp)); height:calc(13 * var(--vp)); }
  .v7-island { position:absolute; z-index:8; left:50%; top:calc(14 * var(--vp)); width:calc(124 * var(--vp)); height:calc(36 * var(--vp)); margin-left:calc(-62 * var(--vp)); border-radius:calc(18 * var(--vp)); background:#000; pointer-events:none; }
  .v7-island i { position:absolute; right:calc(11 * var(--vp)); top:calc(11.5 * var(--vp)); width:calc(13 * var(--vp)); height:calc(13 * var(--vp)); border-radius:50%; background:radial-gradient(circle at 40% 38%,#2b3550,#10131d 55%,#05060a); }
  .v7-home { position:absolute; z-index:8; bottom:calc(8 * var(--vp)); left:50%; width:calc(134 * var(--vp)); height:calc(5 * var(--vp)); margin-left:calc(-67 * var(--vp)); border-radius:calc(3 * var(--vp)); background:#17211d; pointer-events:none; }
</style>
