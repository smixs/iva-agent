---
// The page footer: the logo, the links in three short columns and one line on who makes Iva,
// over a wave of the site's pixels rolling along its bottom edge.
const { lang = "en", home, other } = Astro.props as { lang?: string; home: string; other: string };
const ru = lang === "ru";
const docs = ru ? "/ru" : "";
const groups: [string, [string, string, string?][]][] = [
  [ru ? "Ива" : "Iva", [
    [ru ? "Документация" : "Docs", docs + "/docs/"],
    [ru ? "Вопросы" : "FAQ", home + "#faq"],
    [ru ? "История изменений" : "Changelog", "https://github.com/smixs/iva-agent/blob/main/CHANGELOG.md"],
  ]],
  [ru ? "Проект" : "Project", [
    [ru ? "О команде" : "About the team", docs + "/about/"],
    [ru ? "Бренд" : "Brand", "/docs/brand/"],
    [ru ? "Лицензия MIT" : "MIT license", "https://github.com/smixs/iva-agent/blob/main/LICENSE"],
  ]],
  [ru ? "Сайт" : "Site", [
    [ru ? "English" : "Русский", other, ru ? "en" : "ru"],
    [ru ? "Приватность" : "Privacy", "/privacy/"],
  ]],
];
---

<footer class="footer" data-footer>
  <canvas class="footer-wave" data-footer-wave aria-hidden="true"></canvas>
  <div class="footer-inner">
    <a class="footer-brand" href={home} aria-label={ru ? "Ива, главная" : "Iva home"}>
      <img src="/brand/logo-light.svg" alt="IVA" width="104" height="48" loading="lazy" decoding="async" />
    </a>
    <nav class="footer-links" aria-label={ru ? "Ссылки в подвале" : "Footer links"}>
      {groups.map(([title, links], i) => (
        <div class="footer-group">
          <p class="footer-title">{title}</p>
          <ul data-footer-group={i === groups.length - 1 ? "site" : undefined}>
            {links.map(([name, href, linkLang]) => <li><a href={href} lang={linkLang}>{name}</a></li>)}
          </ul>
        </div>
      ))}
    </nav>
    <div class="footer-base">
      <p>© {new Date().getFullYear()} Majento · {ru ? "Ташкент" : "Tashkent"}</p>
      <p>{ru ? "Разработка ИИ-систем для компаний:" : "Custom AI systems for companies:"} <a href="https://majento.ai/?utm_source=iva-agent.com&amp;utm_medium=referral&amp;utm_campaign=ecosystem">Majento</a></p>
    </div>
  </div>
</footer>
<script>
  // Along the bottom of the footer lies a band of square pixels, green on top, blue and darker
  // below, level but for a cell here and there. Out of it thin shoots spring up all the time like
  // willow twigs, one column of pixels each, tapering to a point, in little hills: the tallest in
  // the middle and the others stepping down from it on both sides; a hill stands a moment and
  // sinks back, and the tip of many a shoot comes off and floats up, slowly, swaying and fading. The pointer near the band makes shoots
  // spring up under it and floating pixels shy away from it; a click or tap on the footer sends
  // up a burst. Runs only on screen; with reduced motion it stands still.
  const footer = document.querySelector<HTMLElement>("[data-footer]");
  const canvas = document.querySelector<HTMLCanvasElement>("[data-footer-wave]");
  if (footer && canvas) {
    const ctx = canvas.getContext("2d")!;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const GREEN = ["#c9ea96", "#a4dc55", "#86c140"], BLUE = ["#d6e7f5", "#62a2dc", "#368ad2"], DEEP = ["#3f78ab", "#2b6291"];
    let seed = 20261106;
    const rand = () => {
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
    const hash = (a: number, b: number) => ((((a * 73856093) ^ (b * 19349663)) >>> 0) % 1000) / 1000;
    // Colour of a pixel by its depth under the top of the band, a little mixed so it looks woven.
    const shade = (depth: number, h: number) =>
      depth === 0 ? GREEN[h < 0.45 ? 0 : 1]
      : depth < 2 ? GREEN[h < 0.6 ? 1 : 2]
      : depth < 4 ? (h < 0.5 ? GREEN[2] : BLUE[1])
      : depth < 7 ? BLUE[h < 0.55 ? 1 : 2]
      : h < 0.15 ? BLUE[0] : DEEP[h < 0.6 ? 0 : 1];

    // Shoots: a column each, springing up, standing a moment, sinking back slower; some bend a cell
    // aside near the top, and the tip comes off with its own chance. Heights are in cells above
    // the band.
    type Shoot = { i: number; peak: number; born: number; rise: number; hold: number; fall: number; lean: number; bend: number; blue: boolean; tip: number; tipped: boolean };
    const shoots: Shoot[] = [];
    let W = 0, H = 0, dpr = 1, cell = 10, band = 150, cols = 0;
    const resize = () => {
      const box = footer.getBoundingClientRect();
      if (!box.width || !box.height) return false;
      W = box.width; H = box.height;
      dpr = Math.min(2, devicePixelRatio || 1);
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      band = parseFloat(getComputedStyle(footer).getPropertyValue("--wave")) || 150;
      cell = Math.max(7, Math.min(11, W / 140));
      const n = Math.ceil(W / cell) + 1;
      if (n !== cols) {
        cols = n;
        shoots.length = 0;
        // Standing still, a fixed scatter of little hills at their full height.
        if (reduce) for (let i = 0; i < cols; i++) if (hash(i, 11) < 0.05) {
          const blue = hash(i, 14) < 0.3, peak = 3 + Math.floor(hash(i, 12) * 7);
          const put = (j: number, h: number) => { if (j >= 0 && j < cols) shoots.push({ i: j, peak: h, born: 0, rise: 1, hold: 1, fall: 1, lean: 0, bend: 1, blue, tip: 0, tipped: true }); };
          put(i, peak);
          for (const side of [-1, 1]) for (let k = 1, h = peak; (h = Math.min(h - 1, Math.round(h * 0.75))) > 0; k++) put(i + side * k, h);
        }
      }
      return true;
    };
    // The band: about a third of the wave's room high, a cell up or down here and there that
    // changes now and then, and a slow rise and fall along it, in whole cells.
    const ground = (i: number, t: number) =>
      Math.max(2, Math.round((band * 0.3) / cell + 0.9 * Math.sin((i / 31) * 6.283 + t * 0.4) + (hash(i, Math.floor(t * 0.9 + hash(i, 5) * 9)) < 0.3 ? 1 : 0)));
    // A burst: a little hill of shoots, the tallest in the middle and the others stepping down
    // from it on both sides, each side at its own gentle slope, a cell or two a step, so the steps
    // run on smoothly to the band. The middle goes up first and the steps follow outwards; the hill
    // sinks back whole, its outer steps a moment before the middle.
    const burst = (c: number, t: number, tall = 1) => {
      if (shoots.length > 420) return;
      const peak = Math.max(3, Math.round((4 + 7 * rand() ** 1.3) * tall)), blue = rand() < 0.3;
      const rise = 0.24 + 0.18 * rand(), hold = 0.25 + 0.4 * rand(), fall = 1 + 0.8 * rand();
      const add = (i: number, h: number, k: number, lean: number, tip: number) => {
        if (i >= 0 && i < cols) shoots.push({ i, peak: h, born: t + 0.05 * k, rise, hold: Math.max(0, hold - 0.1 * k), fall, lean, bend: 0.5 + 0.3 * rand(), blue, tip, tipped: false });
      };
      add(c, peak, 0, rand() < 0.3 ? (rand() < 0.5 ? -1 : 1) : 0, 0.6);
      for (const side of [-1, 1]) {
        const slope = 0.68 + 0.2 * rand();
        for (let k = 1, h = peak; k <= 9 && (h = Math.min(h - 1, Math.round(h * slope + (rand() - 0.5) * 0.6))) > 0; k++) add(c + side * k, h, k, 0, 0.06);
      }
    };
    // Height of a shoot at a moment, in cells; below zero once it has sunk back.
    const height = (s: Shoot, t: number) => {
      if (reduce) return s.peak;
      const u = t - s.born;
      if (u < 0) return 0;
      if (u < s.rise) return s.peak * (1 - (1 - u / s.rise) ** 3);
      if (u < s.rise + s.hold) return s.peak;
      const v = (u - s.rise - s.hold) / s.fall;
      return v < 1 ? s.peak * (1 - v * v) : -1;
    };
    const column = (s: Shoot, r: number) => s.i + (s.lean && r >= s.bend * s.peak ? s.lean : 0);

    type Mote = { x: number; y: number; vx: number; vy: number; age: number; life: number; colour: string; phase: number };
    const motes: Mote[] = [];
    const tear = (x: number, y: number, up: number, side: number, colour: string) => {
      if (motes.length < 220) motes.push({ x, y, vx: side + (rand() - 0.5) * 16, vy: -up, age: 0, life: 2.6 + rand() * 2.6, colour, phase: rand() * 6.283 });
    };
    const loose = () => { const pick = rand(); return pick < 0.55 ? GREEN[pick < 0.25 ? 0 : 1] : pick < 0.85 ? BLUE[1] : BLUE[0]; };

    // Pointer in footer pixels, its smoothed velocity, when it last moved by the wall clock and by
    // the frame clock.
    let pointer: [number, number] | null = null, pvx = 0, pvy = 0, moved = 0, stirred = -1, wake = 0, budget = 0, spawn = 0;
    let clock = 0;
    const step = (dt: number) => {
      clock += dt;
      // New hills all the time: at any moment about a third of the band has one on it.
      spawn += dt * cols * 0.024;
      while (spawn >= 1) { spawn -= 1; burst(Math.floor(rand() * cols), clock); }
      for (let k = shoots.length - 1; k >= 0; k--) {
        const s = shoots[k];
        if (height(s, clock) < 0) { shoots.splice(k, 1); continue; }
        // At the top of its rise the tip of many a shoot comes off and flies on up.
        if (!s.tipped && clock - s.born >= s.rise) {
          s.tipped = true;
          if (rand() < s.tip) {
            const r = ground(s.i, clock) + s.peak - 1;
            tear(column(s, s.peak - 1) * cell, H - (r + 1) * cell, 70 + rand() * 90, s.lean * 12, (s.blue ? BLUE : GREEN)[0]);
            s.peak -= 1;
          }
        }
      }
      // The pointer near the band makes shoots spring up under it, the faster it moves the more.
      if (pointer && clock - stirred < 0.12) {
        const run = Math.min(900, Math.hypot(pvx, pvy));
        const ci = pointer[0] / cell, c = Math.round(Math.min(cols - 1, Math.max(0, ci)));
        const above = H - ground(c, clock) * cell - pointer[1];
        const near = above < 0 ? 1 : Math.max(0, 1 - above / 110);
        budget += near * (1 + run * 0.01) * dt;
        while (budget >= 1) { budget -= 1; burst(Math.round(ci + (rand() - 0.5) * 4), clock, 1.15); }
      }
      // Now and then a pixel comes off the band by itself.
      if (rand() < dt * Math.max(0.5, W / 960)) {
        const i = Math.floor(rand() * cols);
        tear(i * cell, H - (ground(i, clock) + 1) * cell, 34 + rand() * 50, 0, loose());
      }
      // Floating pixels rise faster as they go, sway, drift and shy from the pointer, all at half
      // speed, as if in slow motion; the pointer still pushes them off as briskly as at full speed.
      const md = dt * 0.5;
      for (let k = motes.length - 1; k >= 0; k--) {
        const m = motes[k];
        m.age += md;
        m.vy -= 16 * md;
        m.vx += (6 * Math.sin(clock * 0.225 + m.phase) - m.vx * 0.6) * md;
        if (pointer) {
          const dx = m.x - pointer[0], dy = m.y - pointer[1], d = Math.hypot(dx, dy);
          if (d < 90 && d > 0.01) { const f = (10400 * (1 - d / 90) ** 2) / d; m.vx += dx * f * md; m.vy += dy * f * md; }
        }
        m.vx *= 1 - 0.4 * md; m.vy *= 1 - 0.15 * md;
        m.x += m.vx * md + Math.sin(m.age * 2.3 + m.phase) * 9 * md;
        m.y += m.vy * md;
        if (m.age > m.life || m.y < -cell) motes.splice(k, 1);
      }
    };

    const draw = () => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const inner = cell - Math.max(1, cell * 0.14);
      let fill = "", alpha = -1;
      // Squares stand on the bottom of their cell, so a small tip sits on the pixel under it.
      const square = (x: number, y: number, size: number, colour: string, a: number) => {
        if (colour !== fill) ctx.fillStyle = fill = colour;
        if (a !== alpha) ctx.globalAlpha = alpha = a;
        const s = Math.max(1, Math.round(size * dpr));
        ctx.fillRect(Math.round(x * dpr + (inner * dpr - s) / 2), Math.round(y * dpr + (inner * dpr - s)), s, s);
      };
      const t = reduce ? 0 : clock, tick = Math.floor(t * 1.3);
      for (let i = 0; i < cols; i++) {
        const n = ground(i, t);
        for (let r = 0; r < n; r++) {
          const dim = !reduce && hash(i * 7 + r, tick + (i % 5)) < 0.04 ? 0.6 : 1;
          square(i * cell, H - (r + 1) * cell, inner, shade(n - 1 - r, hash(i, r)), dim);
        }
      }
      // Each shoot stands on the band a whole cell at a time; its top two pixels taper to a point.
      for (const s of shoots) {
        const h = Math.floor(height(s, t)), g = ground(s.i, t), tone = s.blue ? BLUE : GREEN;
        for (let r = 0; r < h; r++) {
          const fromTop = h - 1 - r;
          square(column(s, r) * cell, H - (g + r + 1) * cell, inner * (fromTop === 0 ? 0.6 : fromTop === 1 ? 0.84 : 1), tone[fromTop === 0 ? 0 : r === 0 ? 2 : 1], 1);
        }
      }
      for (const m of motes) {
        const fade = m.age / m.life;
        square(m.x, m.y, inner * (0.85 - 0.4 * fade), m.colour, Math.min(1, (1 - fade) * 1.6));
      }
      ctx.globalAlpha = 1;
    };

    let raf = 0, last = 0, seen = false;
    const frame = (now: number) => {
      raf = requestAnimationFrame(frame);
      // Every frame while the pointer plays with it, about 30 a second otherwise.
      if (last && now - last < 31 && now > wake) return;
      step(last ? Math.min(0.05, (now - last) / 1000) : 0);
      last = now;
      draw();
    };
    const start = () => { if (!raf && !reduce && seen && !document.hidden) { last = 0; raf = requestAnimationFrame(frame); } };
    const stop = () => { cancelAnimationFrame(raf); raf = 0; };
    new ResizeObserver(() => { if (resize()) draw(); }).observe(footer);
    if (!reduce) {
      new IntersectionObserver(([entry]) => { seen = entry.isIntersecting; if (seen) start(); else stop(); }).observe(footer);
      document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
      const at = (e: PointerEvent): [number, number] => {
        const box = footer.getBoundingClientRect();
        return [e.clientX - box.left, e.clientY - box.top];
      };
      footer.addEventListener("pointermove", (e) => {
        const p = at(e), now = performance.now();
        if (pointer && now > moved) {
          const k = Math.min(1, (now - moved) / 60), s = 1000 / Math.max(8, now - moved);
          pvx += ((p[0] - pointer[0]) * s - pvx) * k; pvy += ((p[1] - pointer[1]) * s - pvy) * k;
        }
        pointer = p; moved = now; stirred = clock; wake = now + 600;
      }, { passive: true });
      footer.addEventListener("pointerleave", () => { pointer = null; pvx = pvy = 0; });
      // A click or tap on the footer itself, not on a link, sends up a few tall hills and a
      // spray of pixels.
      footer.addEventListener("pointerdown", (e) => {
        if ((e.target as Element).closest("a, button")) return;
        const ci = at(e)[0] / cell, c = Math.round(Math.min(cols - 1, Math.max(0, ci)));
        for (let k = 0; k < 3; k++) burst(Math.round(ci + (rand() - 0.5) * 16), clock + rand() * 0.2, 1.3);
        for (let k = 0; k < 18; k++) tear((ci + (rand() - 0.5) * 6) * cell, H - (ground(c, clock) + 1) * cell, 140 + rand() * 200, (rand() - 0.5) * 160, loose());
        wake = performance.now() + 1500;
      });
    }
  }
</script>
<style>
  .footer { --wave:150px; position:relative; overflow:hidden; font-size:13px; line-height:1.45; }
  .footer-wave { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; }
  .footer-inner { position:relative; max-width:1280px; margin:auto; padding:48px var(--gutter) calc(var(--wave) + 12px); display:grid; grid-template-columns:minmax(0, 1fr) auto; align-items:start; gap:32px 64px; }
  .footer-brand { justify-self:start; padding:2px 0; }
  .footer-brand img { display:block; width:96px; height:auto; }
  .footer-links { display:grid; grid-template-columns:repeat(3, max-content); gap:24px 56px; }
  .footer-title { margin:0 0 10px; color:#66746c; font-size:12px; }
  .footer-group ul { display:grid; gap:7px; margin:0; padding:0; list-style:none; }
  .footer-group a, .footer-group :global(.analytics-settings) { padding:0; border:0; background:none; color:var(--ink); font:inherit; font-size:13px; text-decoration:none; cursor:pointer; }
  .footer-base { grid-column:1 / -1; display:flex; flex-wrap:wrap; justify-content:space-between; gap:6px 24px; padding-top:18px; border-top:1px solid var(--line); color:#66746c; font-size:12px; }
  .footer-base p { margin:0; }
  .footer-base a { color:var(--ink); text-decoration:none; }
  .footer a:hover, .footer-group :global(.analytics-settings:hover) { color:var(--link); text-decoration:none; }
  @media (max-width:760px) {
    .footer { --wave:110px; }
    .footer-inner { grid-template-columns:1fr; padding-top:28px; gap:24px; }
    .footer-links { grid-template-columns:repeat(2, max-content); gap:22px 40px; }
    .footer-base { flex-direction:column; }
  }
</style>
