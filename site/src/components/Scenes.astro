---
import Phone from "./Phone.astro";
import SceneConversation from "./SceneConversation.astro";
import { extras } from "../data/home-extras";
import TelegramFrame from "./TelegramFrame.astro";
import scenes from "../data/scenes.json";
import type { Lang } from "../lib/copy";
const { lang, title } = Astro.props as { lang: Lang; title: string };
const copy = extras[lang];
---

<section id="features" class="section use-cases">
  <span id="asks" class="legacy-anchor" aria-hidden="true"></span>
  <span id="scenarios" class="legacy-anchor" aria-hidden="true"></span>
  <h2>{title}</h2>
  <div class="scene-topics" role="group" aria-label={copy.topicsLabel}>
    {copy.stories.map((story, i) => (
      <button
        type="button"
        data-topic={i}
        aria-pressed={i === 0 ? "true" : "false"}
        aria-controls="topic-phone"
      >
        {story.topic}
      </button>
    ))}
  </div>
  <div class="topic-preview">
    <div class="topic-benefit">
      <p class="eyebrow">{copy.benefitLabel}</p>
      <p
        class="topic-caption"
        data-topic-benefit
        aria-live="polite"
        aria-atomic="true"
      >
        {scenes[lang][0].caption}
      </p>
    </div>
    <div id="topic-phone">
      <Phone>
        {scenes[lang].map((scene, index) => (
          <div
            data-topic-panel={index}
            data-caption={scene.caption}
            hidden={index !== 0}
          >
            <TelegramFrame lang={lang} hero={false}>
              <SceneConversation lang={lang} index={index} />
            </TelegramFrame>
          </div>
        ))}
      </Phone>
    </div>
  </div>
  <div class="scene-grid" role="group" tabindex="0" aria-label={title}>
    {scenes[lang].map((scene, index) => (
      <figure class="scene-card">
        <TelegramFrame lang={lang} compact>
          <SceneConversation lang={lang} index={index} />
        </TelegramFrame>
        <figcaption>
          <span>{scene.caption}</span>
        </figcaption>
      </figure>
    ))}
  </div>
  <div class="scene-navigation" hidden>
    <button
      data-scene-direction="-1"
      aria-label={lang === "ru" ? "Предыдущая сцена" : "Previous scene"}
    >
      ←
    </button>
    <span data-scene-position aria-live="polite">
      1 / 12
    </span>
    <button
      data-scene-direction="1"
      aria-label={lang === "ru" ? "Следующая сцена" : "Next scene"}
    >
      →
    </button>
  </div>
</section>
<script>
  const topics = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-topic]"),
  ];
  const panels = [
    ...document.querySelectorAll<HTMLElement>("[data-topic-panel]"),
  ];
  const benefit = document.querySelector<HTMLElement>("[data-topic-benefit]")!;
  function selectTopic(index: number) {
    topics.forEach((button, i) =>
      button.setAttribute("aria-pressed", String(i === index)),
    );
    panels.forEach((panel, i) => (panel.hidden = i !== index));
    benefit.textContent = panels[index].dataset.caption!;
    topics[index].scrollIntoView({
      block: "nearest",
      inline: "nearest",
      behavior: "instant",
    });
  }
  topics.forEach((button, i) => {
    button.addEventListener("click", () => selectTopic(i));
    button.addEventListener("keydown", (event) => {
      let next = i;
      if (event.key === "ArrowRight") next = (i + 1) % topics.length;
      else if (event.key === "ArrowLeft")
        next = (i + topics.length - 1) % topics.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = topics.length - 1;
      else return;
      event.preventDefault();
      selectTopic(next);
      topics[next].focus({ preventScroll: true });
    });
  });
  const grid = document.querySelector<HTMLElement>(".scene-grid")!;
  const cards = [...grid.querySelectorAll<HTMLElement>(".scene-card")];
  const navigation = document.querySelector<HTMLElement>(".scene-navigation")!;
  const position = navigation.querySelector<HTMLElement>(
    "[data-scene-position]",
  )!;
  let current = 0;
  navigation.hidden = false;
  grid.addEventListener(
    "scroll",
    () => {
      current = Math.min(
        cards.length - 1,
        Math.max(
          0,
          Math.round(
            grid.scrollLeft / (cards[1].offsetLeft - cards[0].offsetLeft),
          ),
        ),
      );
      position.textContent = `${current + 1} / ${cards.length}`;
    },
    { passive: true },
  );
  navigation
    .querySelectorAll<HTMLButtonElement>("[data-scene-direction]")
    .forEach((button) =>
      button.addEventListener("click", () => {
        const index = Math.min(
          cards.length - 1,
          Math.max(0, current + Number(button.dataset.sceneDirection)),
        );
        grid.scrollTo({
          left: cards[index].offsetLeft - cards[0].offsetLeft,
          behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
            ? "instant"
            : "smooth",
        });
      }),
    );
  const captions = [...grid.querySelectorAll<HTMLElement>("figcaption")];
  new ResizeObserver(() => {
    captions.forEach((caption) => {
      caption.tabIndex = caption.scrollWidth > caption.clientWidth ? 0 : -1;
    });
  }).observe(grid);
</script>
