---
import reviews from "../data/reviews.json";
import { glue } from "../lib/copy";
const { lang, title } = Astro.props;
// Three short quotes, each a verbatim excerpt of the full message it links to.
const quotes = reviews.filter((r) => r.lang === lang && "short" in r);
---

<section id="reviews" class="section">
  <h2>{title}</h2>
  <div class="reviews">
    {quotes.map((r) => (
      <figure class="review">
        <blockquote>{lang === "ru" ? `«${glue(r.short)}»` : `“${r.short}”`}</blockquote>
        <figcaption>
          <strong>{r.name}</strong>
          <a href={r.url}>{r.handle}</a>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
