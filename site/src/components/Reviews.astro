---
import reviews from "../data/reviews.json";
const { lang } = Astro.props;
const quotes = reviews.filter((r) => r.lang === lang);
---

{quotes.length > 0 && (
  <section id="reviews" class="section">
    <h2>
      {lang === "ru"
        ? "Что говорят те, у кого Ива уже работает"
        : "What people who run Iva say"}
    </h2>
    <div class="reviews">
      {quotes.map((r) => (
        <figure class="review">
          <figcaption>
            <span class="initials" aria-hidden="true">
              {r.name
                .split(" ")
                .map((s) => s[0])
                .slice(0, 2)
                .join("")}
            </span>
            <span>
              <strong>{r.name}</strong>
              <a href={r.url}>
                {r.handle ||
                  (lang === "ru" ? "Сообщение в Telegram" : "Telegram message")}
              </a>
            </span>
          </figcaption>
          <blockquote>{r.text}</blockquote>
          <a class="review-source" href={r.url}>
            <time datetime={r.date.split(".").reverse().join("-")}>
              {r.date}
            </time>{" "}
            · Telegram ↗
          </a>
        </figure>
      ))}
    </div>
  </section>
)}
