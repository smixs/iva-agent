---
// Services Iva works through fly into the hero phone in a wave: each one comes from afar, small and
// faint, grows as it nears, then shrinks into the phone and is gone. Nothing stays hanging around it.
// Coordinates are in the phone wrapper's units: 100cqw is the phone width, the phone is 205cqw tall.
// A service that would start on the hero text or past the screen edge stays out (script below).
import { marks } from "../lib/services";
// [id, desktop x, desktop y, mobile x, mobile y]; no mobile place = desktop only.
type App = [string, number, number, number?, number?];
const apps: App[] = [
  ["taxi", -22, 14, 7, -7],
  ["gmail", -50, 6, 21.3, -10],
  ["bitrix24", -78, 22, 35.7, -12],
  ["delivery", -36, 38, 50, -12.5],
  ["googlecalendar", -64, 52, 64.3, -12],
  ["1c", -14, 62, 78.7, -10],
  ["notion", -44, 76, 93, -7],
  ["googlesheets", -80, 86],
  ["slack", -26, 100],
  ["googledrive", -58, 118],
  ["todoist", -12, 136],
  ["github", -40, 150],
  ["obsidian", 120, 18],
  ["linear", 126, 58],
  ["googledocs", 118, 100],
  ["googletasks", 124, 142],
];
// The wave rolls down the phone on wide screens and across its top on narrow ones.
const wave = [...apps].sort((a, b) => a[2] - b[2]);
const mobile = apps.filter((a) => a[3] !== undefined);
// Each service flies into the nearest edge of the phone, a little towards its middle.
const flight = ([id, x, y, mx = 0, my = 0]: App) => {
  const [, bg, fg] = marks[id];
  const tx = (x > 50 ? 90 : 10) - x;
  const ty = (102 - y) * 0.3;
  return `--bg:${bg};--fg:${fg};--x:${x};--y:${y};--tx:${tx};--ty:${ty};--mx:${mx};--my:${my};--mtx:${(50 - mx) * 0.4};--mty:${10 - my}`;
};
---
<div class="v7-apps" data-apps aria-hidden="true">
  {apps.map((a) => (
    <span
      class:list={["v7-app", a[3] === undefined && "is-desk-only"]}
      data-app={a[0]}
      style={`${flight(a)};--o:${wave.indexOf(a)};--mo:${mobile.indexOf(a)}`}
    >
      <span class="v7-app-art" set:html={marks[a[0]][0]} />
    </span>
  ))}
</div>
<script>
  const apps = document.querySelector<HTMLElement>("[data-apps]");
  // Keep out every service that would start on the hero text or cross the screen edge.
  const fit = () => {
    if (!apps) return;
    const wrap = apps.getBoundingClientRect();
    const text: DOMRect[] = [];
    for (const el of document.querySelectorAll(".hero-heading span, .hero-intro .lead, .hero-note")) {
      const range = document.createRange();
      range.selectNodeContents(el);
      text.push(...range.getClientRects());
    }
    for (const el of document.querySelectorAll(".hero-intro .button, .v7-cue-text, .v7-cue-arrow")) if (el.getClientRects().length) text.push(el.getBoundingClientRect());
    for (const app of apps.querySelectorAll<HTMLElement>(".v7-app")) {
      const l = wrap.left + app.offsetLeft, t = wrap.top + app.offsetTop;
      const r = l + app.offsetWidth, b = t + app.offsetHeight;
      app.toggleAttribute("data-off", l < 8 || r > innerWidth - 8 || text.some((k) => l < k.right + 16 && r > k.left - 16 && t < k.bottom + 12 && b > k.top - 12));
    }
  };
  // The wave starts once the page opening has finished (Home.astro), or right away.
  const start = () => {
    fit();
    apps?.setAttribute("data-on", "");
    new ResizeObserver(fit).observe(document.querySelector(".hero") || document.body);
    document.fonts?.ready.then(fit);
  };
  const intro = document.documentElement.dataset.intro;
  if (intro === "play" || intro === "fly") window.addEventListener("iva:intro-done", start, { once: true });
  else start();
</script>
<style>
  .v7-apps { position:absolute; inset:0; z-index:0; pointer-events:none; --s:12.5cqw; --step:.18s; --cycle:7s; }
  .v7-app { position:absolute; left:calc(var(--x) * 1cqw - var(--s) / 2); top:calc(var(--y) * 1cqw - var(--s) / 2); width:var(--s); height:var(--s); border-radius:28%; background:var(--bg); color:var(--fg); box-shadow:0 .5cqw 2.2cqw rgb(18 44 32 / .13), 0 0 0 .22cqw rgb(18 44 32 / .06); display:grid; place-items:center; opacity:0; --fx:var(--tx); --fy:var(--ty); --n:var(--o); }
  .v7-app[data-off] { visibility:hidden; }
  .v7-app-art { display:grid; place-items:center; width:56%; height:56%; }
  .v7-app-art :global(svg) { display:block; width:100%; height:100%; }
  .v7-app[data-app="1c"] .v7-app-art, .v7-app[data-app="bitrix24"] .v7-app-art { width:68%; }

  /* One flight takes the first quarter of the cycle; the rest of the cycle the service is gone. */
  .v7-apps[data-on] .v7-app { animation:v7-app-move var(--cycle) linear calc(var(--n) * var(--step)) infinite both, v7-app-look var(--cycle) linear calc(var(--n) * var(--step)) infinite both; }
  @keyframes v7-app-move {
    /* Slow while it is far away, then drawn faster and faster into the phone. */
    0% { translate:0 0; animation-timing-function:cubic-bezier(.5, 0, .85, .4); }
    24%, 100% { translate:calc(var(--fx) * 1cqw) calc(var(--fy) * 1cqw); }
  }
  @keyframes v7-app-look {
    0% { opacity:0; scale:.4; animation-timing-function:cubic-bezier(.22, 1, .36, 1); }
    8% { opacity:1; scale:1; animation-timing-function:cubic-bezier(.5, 0, .9, .5); }
    24%, 100% { opacity:0; scale:.2; }
  }

  /* Phone under the heading: the services come from above and drop into its top edge. */
  @media (max-width:960px) {
    .v7-apps { --s:11cqw; --step:.22s; --cycle:5s; }
    .v7-app { left:calc(var(--mx) * 1cqw - var(--s) / 2); top:calc(var(--my) * 1cqw - var(--s) / 2); --fx:var(--mtx); --fy:var(--mty); --n:var(--mo); }
    .v7-app.is-desk-only { display:none; }
    .v7-app:not(.is-desk-only) .v7-app-art { width:56%; }
  }
  @media (prefers-reduced-motion:reduce) {
    .v7-apps { display:none; }
  }
</style>
