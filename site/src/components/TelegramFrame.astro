---
const { lang = "en", compact = false } = Astro.props;
const ru = lang === "ru";
---

<div
  class:list={["telegram-window", { "telegram-compact": compact }]}
  data-compact={compact ? "true" : undefined}
  data-telegram-chat
  data-hero-chat={compact ? undefined : ""}
  role="group"
  aria-label={ru ? "Пример разговора с Ивой" : "Example conversation with Iva"}
>
  <div class="telegram-toolbar">
    <span class="telegram-back" aria-hidden="true">
      ‹
    </span>
    <div class="telegram-peer">
      <strong>{ru ? "Ива" : "Iva"}</strong>
      <span
        data-peer-status
        data-idle={ru ? "бот" : "bot"}
        data-typing={ru ? "печатает…" : "typing…"}
      >
        {ru ? "бот" : "bot"}
      </span>
    </div>
    <img
      src="/brand/mark.svg"
      width="42"
      height="42"
      alt=""
      loading={compact ? "lazy" : "eager"}
      decoding="async"
    />
  </div>
  <div
    class="telegram-history"
    tabindex="0"
    aria-label={ru ? "История переписки" : "Conversation history"}
  >
    <div class="telegram-messages">
      <slot />
      <div
        class="telegram-bubble telegram-in telegram-thinking"
        data-thinking
        hidden
        aria-hidden="true"
      >
        <i />
        <i />
        <i />
      </div>
    </div>
  </div>
  <div class="telegram-compose">
    <svg
      width="21"
      height="24"
      viewBox="0 0 21 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      aria-hidden="true"
    >
      <path d="m14 6-7 9a3 3 0 0 0 5 4l6-9a5 5 0 0 0-8-6L3 14a7 7 0 0 0 11 8" />
    </svg>
    <span>{ru ? "Сообщение" : "Message"}</span>
    <svg
      width="21"
      height="24"
      viewBox="0 0 21 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      aria-hidden="true"
    >
      <rect x="7" y="2" width="7" height="13" rx="3.5" />
      <path d="M3 10v2a7.5 7.5 0 0 0 15 0v-2M10.5 20v3M6 23h9" />
    </svg>
  </div>
</div>
<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  document
    .querySelectorAll<HTMLElement>("[data-telegram-chat]")
    .forEach((chat) => {
      const history = chat.querySelector<HTMLElement>(".telegram-history")!;
      const status = chat.querySelector<HTMLElement>("[data-peer-status]")!;
      const thinking = chat.querySelector<HTMLElement>("[data-thinking]")!;
      const steps = [...chat.querySelectorAll<HTMLElement>("[data-chat-step]")];
      // V5 beats at 60 fps: typing 50f, voice -> thinking 50f -> answer 90f;
      // follow-up 150f later, typing 40f, answer 60f. Scene transitions are omitted.
      const heroBeats: [number, string][] = [
        [800, "brief"],
        [2000, "voice"],
        [2833, "thinking"],
        [4333, "tasks"],
        [5200, "buttons"],
        [6833, "question"],
        [7500, "thinking"],
        [8500, "answer"],
      ];
      const beats: [number, string][] = chat.dataset.compact
        ? steps
            .flatMap((step, i): [number, string][] => {
              const at = Number(step.dataset.at);
              const result: [number, string][] = [[at, step.dataset.chatStep!]];
              if (i > 0 && step.classList.contains("telegram-in"))
                result.unshift([at - 1000, "thinking"]);
              return result;
            })
            .sort((a, b) => a[0] - b[0])
        : heroBeats;
      let raf = 0,
        start = 0,
        index = 0,
        visible = true,
        lastScroll = 0;
      const scroll = () => {
        history.scrollTop = history.scrollHeight;
      };
      function typing(on: boolean) {
        thinking.hidden = !on;
        status.textContent = on ? status.dataset.typing! : status.dataset.idle!;
        chat.classList.toggle("is-typing", on);
        if (on) chat.querySelector(".telegram-messages")?.append(thinking);
      }
      function final() {
        cancelAnimationFrame(raf);
        steps.forEach((s) => (s.hidden = false));
        typing(false);
        chat.classList.remove("is-playing");
        requestAnimationFrame(scroll);
      }
      function reset() {
        steps.forEach((s) => {
          s.hidden = true;
          s.classList.remove("bubble-arrive", "voice-playing");
        });
        typing(true);
        chat.classList.add("is-playing");
        history.scrollTop = 0;
        index = 0;
      }
      function frame(time: number) {
        if (reduce.matches) {
          final();
          return;
        }
        if (document.hidden || !visible) return;
        if (!start) {
          start = time;
          reset();
        }
        let elapsed = time - start;
        if (elapsed > 13000) {
          start = time;
          reset();
          elapsed = 0;
        }
        while (index < beats.length && elapsed >= beats[index][0]) {
          const name = beats[index++][1];
          if (name === "thinking") typing(true);
          else {
            typing(false);
            const step = steps.find((s) => s.dataset.chatStep === name)!;
            step.hidden = false;
            step.classList.add("bubble-arrive");
            if (name === "voice") step.classList.add("voice-playing");
          }
          lastScroll = time;
        }
        // Follow arriving bubbles inside the fixed viewport, like Telegram's chat list.
        if (time - lastScroll < 500)
          history.scrollTop +=
            (history.scrollHeight - history.clientHeight - history.scrollTop) *
            0.22;
        raf = requestAnimationFrame(frame);
      }
      function update() {
        cancelAnimationFrame(raf);
        if (reduce.matches) {
          final();
          return;
        }
        if (!visible || document.hidden) {
          chat.classList.remove("is-playing");
          return;
        }
        start = 0;
        raf = requestAnimationFrame(frame);
      }
      reduce.addEventListener("change", update);
      document.addEventListener("visibilitychange", update);
      new IntersectionObserver(
        (entries) => {
          visible = entries[0].isIntersecting;
          update();
        },
        { threshold: 0.1 },
      ).observe(chat);
      update();
    });
</script>
