---
import hero from "../data/mosaics/hero.json";
import heroMobile from "../data/mosaics/hero-mobile.json";
import memory from "../data/mosaics/memory.json";
import memoryMobile from "../data/mosaics/memory-mobile.json";
import writes from "../data/mosaics/writes-first.json";
import userbot from "../data/mosaics/userbot.json";
import privacy from "../data/mosaics/privacy.json";
import install from "../data/mosaics/install.json";
import price from "../data/mosaics/price.json";
const scenes: Record<string, any> = {
  hero,
  "hero-mobile": heroMobile,
  memory,
  "memory-mobile": memoryMobile,
  "writes-first": writes,
  userbot,
  privacy,
  install,
  price,
};
const { scene = "hero", alt = "", eager = false } = Astro.props;
const desktop = scenes[scene],
  mobile = scenes[scene + "-mobile"] || desktop;
const portrait = mobile !== desktop;
---

<div
  class="mosaic"
  data-mosaic={JSON.stringify({ desktop, mobile })}
  style={`--ratio:${desktop.size[0]}/${desktop.size[1]};--mobile-ratio:${mobile.size[0]}/${mobile.size[1]}`}
>
  <picture>
    {portrait && (
      <source
        media="(max-width: 768px)"
        srcset={`/media/${scene}-mobile-540.webp 540w, /media/${scene}-mobile-1080.webp 1080w`}
        sizes="(max-width: 768px) calc(100vw - 44px), 540px"
        width={mobile.size[0]}
        height={mobile.size[1]}
      />
    )}
    <img
      src={`/media/${scene}-800.webp`}
      srcset={`/media/${scene}-800.webp 800w, /media/${scene}-1600.webp 1600w`}
      sizes="(max-width: 768px) calc(100vw - 44px), 560px"
      alt={alt}
      width={desktop.size[0]}
      height={desktop.size[1]}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
  </picture>
  <canvas
    hidden
    aria-hidden="true"
    width={desktop.size[0]}
    height={desktop.size[1]}
  ></canvas>
</div>
<script>
  import { renderScene, type Scene } from "../lib/mosaic";
  const reduced = matchMedia("(prefers-reduced-motion: reduce)"),
    mobile = matchMedia("(max-width: 768px)");
  document.querySelectorAll<HTMLElement>("[data-mosaic]").forEach((el) => {
    const definitions = JSON.parse(el.dataset.mosaic!);
    const canvas = el.querySelector("canvas")!;
    let visible = false,
      raf = 0,
      start = 0,
      last = 0,
      ctx: CanvasRenderingContext2D | null = null;
    let scene: Scene,
      ready = false,
      generation = 0;
    const images = new Map<string, CanvasImageSource>();
    const size = () => {
      if (!scene) return;
      canvas.width = Math.min(
        1200,
        Math.ceil(el.clientWidth * devicePixelRatio),
      );
      canvas.height = Math.ceil((canvas.width * scene.size[1]) / scene.size[0]);
    };
    function frame(time: number) {
      if (!visible || reduced.matches || document.hidden || !ctx || !ready)
        return;
      raf = requestAnimationFrame(frame);
      if (time - last < 40) return;
      last = time;
      if (!start) start = time;
      const age = (time - start) / 1000;
      renderScene(
        ctx,
        scene,
        (age / scene.loop_seconds) % 1,
        images,
        Math.min(1, age),
      );
    }
    async function load() {
      const current = ++generation;
      ready = false;
      canvas.hidden = true;
      images.clear();
      scene = definitions[mobile.matches ? "mobile" : "desktop"];
      size();
      const sources = [
        ...new Set(
          scene.layers
            .filter((l) => l.type === "photo" || l.type === "glitch")
            .map((l) => (l as { src: string }).src),
        ),
      ];
      try {
        await Promise.all(
          sources.map(
            (src) =>
              new Promise<void>((resolve, reject) => {
                const image = new Image();
                image.onload = () => {
                  if (current === generation) images.set(src, image);
                  resolve();
                };
                image.onerror = reject;
                image.src = `/media/${src}-${el.clientWidth * devicePixelRatio > 800 ? 1600 : 800}.webp`;
              }),
          ),
        );
      } catch {
        return;
      }
      if (current !== generation) return;
      ctx = canvas.getContext("2d");
      ready = true;
      start = 0;
      update();
    }
    function update() {
      cancelAnimationFrame(raf);
      if (!visible || reduced.matches || document.hidden) {
        canvas.hidden = true;
        return;
      }
      if (!scene) {
        void load();
        return;
      }
      if (ready && ctx) {
        canvas.hidden = false;
        raf = requestAnimationFrame(frame);
      }
    }
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      update();
    }).observe(el);
    new ResizeObserver(() => {
      size();
      if (ready && visible) update();
    }).observe(el);
    mobile.addEventListener("change", () => {
      cancelAnimationFrame(raf);
      if (visible && !reduced.matches) void load();
      else {
        generation++;
        ready = false;
        scene = undefined!;
        canvas.hidden = true;
      }
    });
    reduced.addEventListener("change", update);
    document.addEventListener("visibilitychange", update);
  });
</script>
