---
import Phone from "./Phone.astro";
import Leaves from "./Leaves.astro";
import { demoCopy, demoMessages, demoMenuCopy } from "../data/demo";
import { phrase, type Lang } from "../lib/copy";
const { lang = "en" } = Astro.props as { lang?: Lang };
const c = demoCopy[lang];
const m = demoMenuCopy[lang];
const messages = demoMessages(lang);
const checks = "M1 5.4 4 8.4 10.2 1.6M6.6 8.1 7 8.4 13.2 1.6";
const tail = "M0 -16.5C0 -7.5 -1.6 -2.6 -6.4 -0.35C-6.9 -0.1 -6.75 0.25 -6.25 0.3C-2.6 0.75 1.6 -0.1 4.6 -2.2L4.6 0L0 0Z";
let seed = 1204; // VoiceOut seed from Film5, not the earlier decorative hero's seed.
const random = () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const wave = Array.from({ length: 36 }, (_, i) => Math.max(2.2, (0.16 + 0.84 * Math.pow(Math.sin(Math.PI * (i + .5) / 36), .55) * (.3 + .7 * random())) * 20));
const escape = (text: string) => text.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
const typed = (text: string, counter: { i: number }) => text.split(/( +)/).map(part => !part || /^ +$/.test(part) ? part : `<span data-word="${counter.i++}">${part === "11:00" ? "<b>11:00</b>" : escape(part)}</span>`).join("");
const prepared = messages.map(message => {
  const counter = { i: 0 };
  const blocks = message.blocks?.map(block => ({
    ...block,
    emojiHtml: block.emoji ? typed(block.emoji, counter) : "",
    html: typed(block.text, counter),
  }));
  return { ...message, blocks, after: counter.i };
});
---
<figure class="v7-demo" data-demo data-ui="telegram-demo" data-lang={lang} aria-label={c.label}>
  <div class="v7-device-wrap">
  <Leaves />
  <Phone>
    {["iva", "maria"].map(peer => (
      <div class:list={["v7-screen", peer === "maria" && "v7-maria"]} data-screen={peer} aria-hidden={peer === "maria" ? "true" : undefined} inert={peer === "maria"}>
        <img class="v7-wall" src="/media/tg-wall.webp" width="402" height="858" alt="" decoding="async" aria-hidden="true" />
        <div class="v7-viewport" data-viewport={peer} role="log" aria-live="off" aria-label={peer === "iva" ? c.iva : c.maria} tabindex="0">
          <div class="v7-feed">
            <div class="v7-date">{peer === "iva" ? c.today : c.yesterday}</div>
            {peer === "iva" ? prepared.map(message => (
              <>
                {message.think !== undefined && (
                  <div class="v7-arrival" data-think={message.id} hidden>
                    <div class="v7-collapse"><div class="v7-arrival-body"><div class="v7-thinking">{c.thinking}</div></div></div>
                  </div>
                )}
                <div class="v7-arrival" data-message={message.id} hidden={message.id !== "morning"}>
                  <div class="v7-collapse"><div class="v7-arrival-body" data-arrival-body>
                    {message.kind === "card" && (
                      <div class="v7-card">
                        {message.blocks?.map(block => (
                          <div class:list={["v7-text-block", `v7-${block.kind}`]}>
                            {block.emoji && <span class="v7-emoji" set:html={block.emojiHtml} />}
                            <span set:html={block.html} />
                          </div>
                        ))}
                        {message.action && (
                          <div data-after-index={message.after}>
                            {message.action === "invoice" && <div class="v7-document"><span class="v7-document-icon">PDF</span><span><b>{c.invoice}</b><small>84 KB</small></span></div>}
                            <div class="v7-swap" data-action={message.action}>
                              <div class="v7-swap-before" data-before><div class="v7-collapse">
                                <div class="v7-buttons">
                                  <button type="button" class="v7-choice is-primary" data-choice="yes" disabled>{c.choices[message.action].yes}</button>
                                  <button type="button" class="v7-choice is-secondary" data-choice="no" disabled>{c.choices[message.action].no}</button>
                                </div>
                              </div></div>
                              <div class="v7-swap-after" data-after hidden><div class="v7-collapse">
                                <div class="v7-result" data-result>
                                  <div data-accepted>{message.action === "shopping" ? c.shopping.map(block => <div class="v7-item"><span class="v7-emoji">{block.emoji}</span><span>{block.text}</span></div>) : c.choices[message.action].accepted}</div>
                                  <div data-declined hidden>{c.choices[message.action].declined}</div>
                                </div>
                              </div></div>
                            </div>
                          </div>
                        )}
                        <div class="v7-time is-block" data-message-time={message.id}>{message.time}</div>
                      </div>
                    )}
                    {message.kind === "out" && <div class="v7-bubble is-out"><svg class="v7-tail" viewBox="-7 -17 14 17" aria-hidden="true"><path d={tail} /></svg><span>{message.text}</span><span class="v7-time">{message.time}<svg viewBox="0 0 17 10" aria-hidden="true"><path d={checks} /></svg></span></div>}
                    {message.kind === "voice" && (
                      <div class="v7-voice" aria-label={c.voice}>
                        <svg class="v7-tail" viewBox="-7 -17 14 17" aria-hidden="true"><path d={tail} /></svg>
                        <span class="v7-voice-play" aria-hidden="true"><svg viewBox="0 0 16 18"><path d="M2 2.2C2 1.1 3.2.5 4.1 1.1l10 6.6c.8.6.8 1.8 0 2.4l-10 6.6C3.2 17.3 2 16.7 2 15.6z" /></svg></span>
                        <span class="v7-voice-body">
                          <svg class="v7-wave" viewBox="0 0 133.2 20" aria-hidden="true">{wave.map((h, i) => <rect x={i * 3.7} y={20 - h} width="2.2" height={h} rx="1.1" />)}</svg>
                          <span class="v7-voice-meta"><span>0:12</span><span class="v7-time">12:04<svg viewBox="0 0 17 10" aria-hidden="true"><path d={checks} /></svg></span></span>
                        </span>
                      </div>
                    )}
                    {message.kind === "date" && <div class="v7-date">{message.text}</div>}
                  </div></div>
                </div>
              </>
            )) : (
              <>
                <div class="v7-bubble"><svg class="v7-tail" viewBox="-7 -17 14 17" aria-hidden="true"><path d={tail} /></svg>{c.mariaMessages[0]}<span class="v7-time">21:14</span></div>
                <div class="v7-bubble is-out"><svg class="v7-tail" viewBox="-7 -17 14 17" aria-hidden="true"><path d={tail} /></svg>{c.mariaMessages[1]}<span class="v7-time">21:20<svg viewBox="0 0 17 10" aria-hidden="true"><path d={checks} /></svg></span></div>
                <div class="v7-date">{c.today}</div>
                <div class="v7-bubble"><svg class="v7-tail" viewBox="-7 -17 14 17" aria-hidden="true"><path d={tail} /></svg>{c.mariaMessages[2]}<span class="v7-time">17:38</span></div>
                <div class="v7-arrival" data-venue hidden><div class="v7-collapse"><div class="v7-arrival-body">
                  <div class="v7-venue is-out">
                    <svg class="v7-tail" viewBox="-7 -17 14 17" aria-hidden="true"><path d={tail} /></svg>
                    <div class="v7-map"><img src="/media/demo-map.png" alt={c.map} width="524" height="300" loading="lazy" decoding="async" /><svg viewBox="-15 -36 30 38" aria-hidden="true"><ellipse cx="0" cy="1" rx="5" ry="2" fill="#00000038" /><path d="M0 0 C-3 -9 -11 -13 -11 -22 A11 11 0 1 1 11 -22 C11 -13 3 -9 0 0Z" fill="#F0453A" stroke="#fff" stroke-width="1.6" /><circle cx="0" cy="-22" r="4.2" fill="#fff" /></svg></div>
                    <div class="v7-venue-info"><b>{c.restaurant}</b><div><span>{c.address}</span><span class="v7-time">17:42<svg viewBox="0 0 17 10" aria-hidden="true"><path d={checks} /></svg></span></div></div>
                  </div>
                </div></div></div>
              </>
            )}
            {peer === "iva" && (
              <>
                <div class="v7-install" data-end-cta data-copy-ru={phrase("ru")} data-copy-en={phrase("en")} hidden>
                  <div class="v7-card">
                    <div class="v7-p" data-install-question>{m.install}</div>
                    <div class="v7-buttons" data-install-buttons>
                      <button type="button" class="v7-choice is-primary" data-install-choice="yes" data-copy={phrase(lang)}>{m.yes}</button>
                      <button type="button" class="v7-choice is-secondary" data-install-choice="no">{m.no}</button>
                    </div>
                    <div class="v7-result" data-install-response data-copy-response hidden></div>
                    <p class="v7-install-copy-status" data-install-copy-status data-copy-status hidden></p>
                    <p class="v7-install-phrase" data-install-phrase data-copy-phrase tabindex="0" hidden>{phrase(lang)}</p>
                    <div class="v7-time is-block">14:31</div>
                  </div>
                </div>
                <div class="v7-menu-entry" data-demo-menu hidden>
                  <div class="v7-bubble is-out v7-menu-command">/menu</div>
                  <div class="v7-card v7-menu-card" id={`v7-settings-${lang}`} data-menu-card tabindex="-1">
                    <div class="v7-menu-title" data-menu-title></div>
                    <div class="v7-menu-description" data-menu-description></div>
                    <div class="v7-menu-keyboard" data-menu-keyboard></div>
                    <div class="v7-menu-install-footer" data-menu-install-footer>
                      <button type="button" class="v7-menu-install-button" data-menu-install data-copy={phrase(lang)}>{m.installIva}</button>
                      <div class="v7-result" data-menu-copy-response data-copy-response hidden></div>
                      <p class="v7-install-copy-status" data-menu-copy-status data-copy-status hidden></p>
                      <p class="v7-install-phrase" data-menu-copy-phrase data-copy-phrase tabindex="0" hidden>{phrase(lang)}</p>
                    </div>
                  </div>
                </div>
              </>
            )}
          </div>
        </div>
        <div class="v7-edge-top" aria-hidden="true"></div>
        <div class="v7-edge-bottom" aria-hidden="true"></div>
        <div class="v7-header" aria-hidden="true">
          <span class="v7-glass v7-back"><svg viewBox="0 0 24 24"><path d="M15 4.5 7.5 12 15 19.5" /></svg><b>3</b></span>
          <span class="v7-glass v7-peer"><strong>{peer === "iva" ? c.iva : c.maria}</strong><span class="v7-sub"><span data-bot>{peer === "iva" ? c.bot : c.online}</span><span class="v7-typing" data-typing hidden><i></i><i></i><i></i>{c.typing}</span></span></span>
          <span class="v7-glass v7-avatar">{peer === "iva" ? <span class="v7-iva-avatar"><img src="/brand/mark.svg" alt="" width="40" height="40" /></span> : <span class="v7-maria-avatar">{lang === "ru" ? "М" : "M"}</span>}</span>
        </div>
        <div class="v7-composer">
          <button type="button" class="v7-menu" data-demo-menu-open aria-label={m.open} aria-controls={`v7-settings-${lang}`} aria-expanded="false"><svg viewBox="0 0 17 17" aria-hidden="true"><path d="M3.5 5h10M3.5 8.5h10M3.5 12h10" /></svg></button>
          <span class="v7-glass v7-clip" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 11.2 12.4 18.8a5 5 0 0 1-7.1-7.1l8-8a3.4 3.4 0 0 1 4.8 4.8l-8 8a1.7 1.7 0 0 1-2.4-2.4l7.3-7.3" /></svg></span>
          <span class="v7-glass v7-field" aria-hidden="true"><span>{c.message}</span><svg viewBox="0 0 24 24"><path d="M12 20.5A8.5 8.5 0 1 1 20.5 12M20.5 12c-4.6 0-8.5 3.8-8.5 8.5" /></svg></span>
          <span class="v7-glass v7-mic" aria-hidden="true"><svg viewBox="0 0 24 24" data-mic><path d="M9 6a3 3 0 0 1 6 0v5.5a3 3 0 0 1-6 0zM5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3" /></svg><span class="v7-stop" data-stop hidden></span></span>
        </div>
        {peer === "iva" && <span class="v7-dim" data-dim aria-hidden="true"></span>}
      </div>
    ))}
    <span class="v7-tap" data-tap aria-hidden="true" hidden></span>
  </Phone>
  <div class="v7-cue" data-menu-cue aria-hidden="true">
    <span class="v7-cue-text">{c.cue}</span>
    <svg class="v7-cue-arrow is-side" viewBox="0 0 96 56"><path pathLength="1" d="M3 9C24 2 49 5 63 18C71 25 80 33 90 37" /><path class="v7-cue-head" pathLength="1" d="M82.5 28.4Q86 32.5 90 37Q84.5 37.4 79 38.4" /></svg>
    <svg class="v7-cue-arrow is-below" viewBox="0 0 30 40"><path pathLength="1" d="M26 37C16 35 9 28 7.5 18C7 13 6.6 8 6 3" /><path class="v7-cue-head" pathLength="1" d="M3.1 10.5Q4.4 6.6 6 3Q8.2 6.3 10.6 9.6" /></svg>
  </div>
  </div>
  <figcaption class="v7-caption">
    <div class="v7-control-row">
      <span class="v7-sr">{c.demo}</span>
      <div class="v7-controls" data-controls hidden>
      <button type="button" data-play hidden><svg viewBox="0 0 16 16" aria-hidden="true" data-play-icon><path d="M5 3v10M11 3v10" /></svg><span data-play-label>{c.pause}</span></button>
      <button type="button" data-replay><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 5A5.5 5.5 0 1 1 2.7 9M3.5 1.7V5H.3" /></svg>{c.replay}</button>
      </div>
    </div>
    <p class="v7-sr" data-demo-hint>{c.hint}</p>
    <span class="v7-sr" data-scene>{c.scenes[0]}</span>
    <span class="v7-sr">{c.note}</span>
    <span class="v7-sr" data-announcement role="status" aria-live="polite"></span>
  </figcaption>
</figure>
<script>
  import { mountDemos } from "../lib/demo";
  mountDemos();
</script>
<style>
  .v7-demo { width:100%; margin:0; }
  .v7-demo [hidden] { display:none !important; }
  .v7-screen { position:absolute; inset:0; overflow:hidden; font-size:max(14px,calc(17 * var(--vp))); line-height:max(18.5px,calc(22.5 * var(--vp))); letter-spacing:calc(-.15 * var(--vp)); }
  .v7-maria { transform:translateX(100%); z-index:2; }
  .v7-wall { position:absolute; inset:0; width:100%; height:100%; object-fit:fill; pointer-events:none; }
  .v7-viewport { position:absolute; inset:calc(116 * var(--vp)) 0 calc(104 * var(--vp)); overflow:auto; scrollbar-width:none; overscroll-behavior:contain; scroll-behavior:auto; outline-offset:calc(-3 * var(--vp)); }
  .v7-viewport::-webkit-scrollbar { display:none; }
  .v7-feed { min-height:100%; display:flex; flex-direction:column; justify-content:flex-end; padding:0 0 calc(2 * var(--vp)); }
  [data-screen="iva"] .v7-feed { justify-content:flex-start; }
  .v7-arrival { display:grid; grid-template-rows:1fr; flex-shrink:0; }
  .v7-collapse { min-height:0; overflow:hidden; display:flex; flex-direction:column; }
  .v7-arrival-body { padding-top:calc(10 * var(--vp)); display:flex; flex-direction:column; }
  [data-message="morning"] .v7-arrival-body { padding-top:0; }
  .v7-card { margin:0 calc(12 * var(--vp)); background:#fff; border-radius:calc(18 * var(--vp)); box-shadow:0 calc(.6 * var(--vp)) calc(1.2 * var(--vp)) #17211d1a; padding:calc(12 * var(--vp)) calc(15 * var(--vp)) calc(7 * var(--vp)); }
  .v7-text-block { margin:calc(2 * var(--vp)) 0; }
  .v7-title { font-family:"V7IvaSerif","Apple Color Emoji",serif; font-size:calc(26 * var(--vp)); line-height:calc(31 * var(--vp)); letter-spacing:calc(-.2 * var(--vp)); margin:calc(1 * var(--vp)) 0 calc(5 * var(--vp)); }
  .v7-item { display:flex; gap:calc(8 * var(--vp)); margin:calc(5 * var(--vp)) 0; }
  .v7-emoji { width:calc(22 * var(--vp)); flex:none; text-align:center; }
  .v7-bubble,.v7-voice,.v7-venue { position:relative; align-self:flex-start; margin:calc(8 * var(--vp)) calc(12 * var(--vp)) 0; max-width:calc(300 * var(--vp)); padding:calc(8 * var(--vp)) calc(13 * var(--vp)); background:#fff; border-radius:calc(18 * var(--vp)) calc(18 * var(--vp)) calc(18 * var(--vp)) 0; box-shadow:0 calc(.6 * var(--vp)) calc(1 * var(--vp)) #17211d1a; }
  .v7-arrival-body > .v7-bubble,.v7-arrival-body > .v7-voice { margin-top:0; }
  .is-out { align-self:flex-end; background:#e1fec7; border-radius:calc(18 * var(--vp)) calc(18 * var(--vp)) 0 calc(18 * var(--vp)); }
  .v7-tail { position:absolute; left:calc(-7 * var(--vp)); bottom:0; width:calc(14 * var(--vp)); height:calc(17 * var(--vp)); fill:#fff; overflow:visible; }
  .is-out > .v7-tail,.v7-voice > .v7-tail { left:auto; right:calc(-7 * var(--vp)); transform:scaleX(-1); fill:#e1fec7; }
  .v7-time { float:right; display:inline-flex; align-items:center; gap:calc(3 * var(--vp)); margin:calc(8 * var(--vp)) 0 calc(-4 * var(--vp)) calc(12 * var(--vp)); font-size:calc(12 * var(--vp)); line-height:calc(15 * var(--vp)); color:rgba(23,33,29,.64); font-variant-numeric:tabular-nums; letter-spacing:0; }
  .v7-time.is-block { float:none; display:flex; justify-content:flex-end; margin:calc(4 * var(--vp)) 0 0; }
  .is-out .v7-time,.v7-voice .v7-time { color:#4fa84c; }
  .v7-time svg { width:calc(17 * var(--vp)); height:calc(10 * var(--vp)); fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }
  .v7-date { align-self:center; background:rgba(23,50,42,.66); color:#fff; padding:calc(3 * var(--vp)) calc(10 * var(--vp)); border-radius:calc(12 * var(--vp)); font-size:calc(14 * var(--vp)); line-height:calc(18 * var(--vp)); font-weight:600; margin:calc(4 * var(--vp)) 0 calc(10 * var(--vp)); }
  .v7-voice { align-self:flex-end; display:flex; align-items:center; gap:calc(9 * var(--vp)); background:#e1fec7; border-radius:calc(18 * var(--vp)) calc(18 * var(--vp)) 0 calc(18 * var(--vp)); padding:calc(7 * var(--vp)) calc(11 * var(--vp)) calc(6 * var(--vp)) calc(7 * var(--vp)); }
  .v7-voice-play { display:grid; place-items:center; width:calc(40 * var(--vp)); height:calc(40 * var(--vp)); border-radius:50%; background:#4fa84c; }
  .v7-voice-play svg { width:calc(16 * var(--vp)); height:calc(18 * var(--vp)); margin-left:calc(2 * var(--vp)); fill:#fff; }
  .v7-voice-body { display:flex; flex-direction:column; }
  .v7-wave { width:calc(133.2 * var(--vp)); height:calc(20 * var(--vp)); fill:#4fa84c99; }
  .v7-voice-meta { display:flex; justify-content:space-between; gap:calc(14 * var(--vp)); margin-top:calc(3 * var(--vp)); font-size:calc(12 * var(--vp)); line-height:calc(15 * var(--vp)); color:#4fa84c; font-variant-numeric:tabular-nums; }
  .v7-voice-meta .v7-time { margin:0; }
  .v7-thinking { align-self:flex-start; margin-left:calc(12 * var(--vp)); border-radius:calc(12 * var(--vp)); background:rgba(226,225,229,.98); padding:calc(6 * var(--vp)) calc(12 * var(--vp)); color:rgba(23,33,29,.82); font-size:max(14px,calc(16 * var(--vp))); line-height:max(18.5px,calc(21 * var(--vp))); }
  .v7-document { display:flex; align-items:center; gap:calc(10 * var(--vp)); margin:calc(10 * var(--vp)) 0 calc(2 * var(--vp)); }
  .v7-document-icon { flex:none; display:grid; place-items:center; width:calc(44 * var(--vp)); height:calc(44 * var(--vp)); border-radius:50%; background:#0589ff; color:#fff; font-size:calc(12 * var(--vp)); font-weight:700; letter-spacing:calc(.2 * var(--vp)); }
  .v7-document b { display:block; font-size:max(14px,calc(16.5 * var(--vp))); line-height:max(18.5px,calc(21 * var(--vp))); font-weight:600; }
  .v7-document small { display:block; font-size:calc(14 * var(--vp)); line-height:calc(18 * var(--vp)); color:#17211da3; }
  .v7-swap-before,.v7-swap-after { display:grid; grid-template-rows:1fr; }
  .v7-buttons { display:flex; gap:calc(7 * var(--vp)); padding-top:calc(10 * var(--vp)); padding-bottom:calc(2 * var(--vp)); }
  .v7-choice { appearance:none; flex:1; min-height:32px; height:max(32px,calc(38 * var(--vp))); padding:0 calc(5 * var(--vp)); border:0; border-radius:calc(19 * var(--vp)); font:inherit; font-size:max(12px,calc(16.5 * var(--vp))); font-weight:600; letter-spacing:calc(-.2 * var(--vp)); white-space:nowrap; cursor:pointer; }
  .v7-choice.is-primary { background:#0589ff; color:#fff; }
  .v7-choice.is-secondary { background:#e7e6e9; color:#17211d; }
  .v7-choice:disabled { cursor:default; }
  .v7-choice:focus-visible { outline:calc(2 * var(--vp)) solid #17211d; outline-offset:calc(-4 * var(--vp)); }
  .v7-result { padding-top:calc(8 * var(--vp)); }
  .v7-venue { max-width:none; width:calc(268 * var(--vp)); padding:calc(3 * var(--vp)); margin-top:0; }
  .v7-map { position:relative; width:100%; height:calc(150 * var(--vp)); overflow:hidden; border-radius:calc(15 * var(--vp)); }
  .v7-map img { display:block; width:100%; height:100%; object-fit:cover; }
  .v7-map svg { position:absolute; width:calc(30 * var(--vp)); height:calc(38 * var(--vp)); left:calc(116 * var(--vp)); top:calc(39 * var(--vp)); }
  .v7-venue-info { padding:calc(6 * var(--vp)) calc(9 * var(--vp)) calc(5 * var(--vp)); }
  .v7-venue-info b { font-size:max(14px,calc(16.5 * var(--vp))); line-height:max(18.5px,calc(21 * var(--vp))); font-weight:600; }
  .v7-venue-info > div { display:flex; align-items:flex-end; justify-content:space-between; gap:calc(8 * var(--vp)); font-size:max(12px,calc(14.5 * var(--vp))); line-height:max(16px,calc(19 * var(--vp))); color:#17211da8; }
