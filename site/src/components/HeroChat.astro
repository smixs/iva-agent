---
// The hero conversation, rebuilt from the demo film's Chat.tsx (header capsules, wallpaper,
// rich card, bubbles with tails, outgoing voice, «Думаю…» draft, composer). Messages arrive
// one by one when the phone scrolls into view (src/scripts/motion.ts); without JS or with
// reduced motion the finished conversation is shown as is.
import Phone from "./Phone.astro";
import { homeCopy, type Lang } from "../lib/copy";
import { mulberry } from "../lib/pixels";
const { lang = "en" } = Astro.props as { lang?: Lang };
const c = homeCopy[lang].chat;
const rnd = mulberry(704);
const bars = 36;
const wave = Array.from({ length: bars }, (_, i) => {
  const env = Math.pow(Math.sin((Math.PI * (i + 0.5)) / bars), 0.55);
  return Math.max(2.2, (0.16 + 0.84 * env * (0.3 + 0.7 * rnd())) * 20);
});
const tail =
  "M0 -16.5C0 -7.5 -1.6 -2.6 -6.4 -0.35C-6.9 -0.1 -6.75 0.25 -6.25 0.3C-2.6 0.75 1.6 -0.1 4.6 -2.2L4.6 0L0 0Z";
const checks = "M1 5.4 4 8.4 10.2 1.6M6.6 8.1 7 8.4 13.2 1.6";
---

<Phone time={c.voice.time.replace(/^0/, "")}>
  <div class="tg" data-chat role="img" aria-label={c.label}>
    <picture class="tg-wall" aria-hidden="true">
      <source srcset="/media/tg-wall.avif" type="image/avif" />
      <img
        src="/media/tg-wall.webp"
        alt=""
        width="402"
        height="640"
        decoding="async"
        fetchpriority="low"
      />
    </picture>
    <div class="tg-list" data-tg-content aria-hidden="true">
      <div class="tg-step is-static">
        <div class="tg-date">{c.today}</div>
      </div>
      <div class="tg-step" data-step="1">
        <div class="tg-slot">
        <div class="tg-card">
          <div class="tg-h1">{c.brief.title}</div>
          <div class="tg-p">{c.brief.intro}</div>
          {
            c.brief.items.map(([emoji, text]) => (
              <div class="tg-item">
                <span>{emoji}</span>
                <span>{text}</span>
              </div>
            ))
          }
          <div class="tg-time is-block">{c.brief.time}</div>
        </div>
        </div>
      </div>
      <div class="tg-step" data-step="2">
        <div class="tg-slot">
        <div class="tg-in">
          <svg class="tg-tail" viewBox="-7 -17 14 17"><path d={tail}></path></svg>
          <span>{c.birthday.text}</span>
          <span class="tg-time">{c.birthday.time}</span>
        </div>
        </div>
      </div>
      <div class="tg-step" data-step="3">
        <div class="tg-slot">
        <div class="tg-voice">
          <svg class="tg-tail" viewBox="-7 -17 14 17"><path d={tail}></path></svg>
          <span class="tg-play">
            <svg viewBox="0 0 16 18"
              ><path
                d="M2 2.2C2 1.1 3.2.5 4.1 1.1l10 6.6c.8.6.8 1.8 0 2.4l-10 6.6C3.2 17.3 2 16.7 2 15.6z"
              ></path></svg
            >
          </span>
          <span class="tg-voice-body">
            <svg class="tg-wave" viewBox={`0 0 ${bars * 3.7} 20`}>
              {
                wave.map((h, i) => (
                  <rect
                    x={(i * 3.7).toFixed(2)}
                    y={(20 - h).toFixed(2)}
                    width="2.2"
                    height={h.toFixed(2)}
                    rx="1.1"
                  />
                ))
              }
            </svg>
            <span class="tg-voice-meta">
              <span>{c.voice.duration}</span>
              <span class="tg-out-time">
                {c.voice.time}
                <svg viewBox="0 0 17 10"><path d={checks}></path></svg>
              </span>
            </span>
          </span>
        </div>
        </div>
      </div>
      <div class="tg-step" data-step="4">
        <div class="tg-slot">
        <div class="tg-thinking">{c.thinking}</div>
        </div>
      </div>
      <div class="tg-step" data-step="5">
        <div class="tg-slot">
        <div class="tg-in">
          <svg class="tg-tail" viewBox="-7 -17 14 17"><path d={tail}></path></svg>
          <span>{c.reply.text}</span>
          <span class="tg-time">{c.reply.time}</span>
        </div>
        </div>
      </div>
    </div>
    <div class="tg-edge-top" aria-hidden="true"></div>
    <div class="tg-edge-bottom" aria-hidden="true"></div>
    <div class="tg-head" aria-hidden="true">
      <span class="tg-glass tg-back">
        <svg viewBox="0 0 24 24"><path d="M15 4.5 7.5 12 15 19.5"></path></svg>
        <b>3</b>
      </span>
      <span class="tg-glass tg-peer">
        <strong>{c.title}</strong>
        <span class="tg-sub">
          <span class="tg-bot">{c.bot}</span>
          <span class="tg-typing"><i></i><i></i><i></i>{c.typing}</span>
        </span>
      </span>
      <span class="tg-glass tg-avatar">
        <span
          ><img
            src="/media/iva-leaves.svg"
            alt=""
            width="803"
            height="1281"
            decoding="async"
          /></span
        >
      </span>
    </div>
    <div class="tg-compose" aria-hidden="true">
      <span class="tg-menu">
        <svg viewBox="0 0 17 17"
          ><path d="M3.5 5h10M3.5 8.5h10M3.5 12h10"></path></svg
        >
      </span>
      <span class="tg-glass tg-clip">
        <svg viewBox="0 0 24 24"
          ><path
            d="M20 11.2 12.4 18.8a5 5 0 0 1-7.1-7.1l8-8a3.4 3.4 0 0 1 4.8 4.8l-8 8a1.7 1.7 0 0 1-2.4-2.4l7.3-7.3"
          ></path></svg
        >
      </span>
      <span class="tg-glass tg-field">
        <span>{c.input}</span>
        <svg viewBox="0 0 24 24"
          ><path d="M12 20.5A8.5 8.5 0 1 1 20.5 12"></path><path
            d="M20.5 12c-4.6 0-8.5 3.8-8.5 8.5"></path></svg
        >
      </span>
      <span class="tg-glass tg-mic">
        <svg viewBox="0 0 24 24"
          ><path d="M9 6a3 3 0 0 1 6 0v5.5a3 3 0 0 1-6 0z"></path><path
            d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3"></path></svg
        >
      </span>
    </div>
  </div>
</Phone>
