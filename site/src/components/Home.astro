---
import Base from "../layouts/Base.astro";
import HeroChat from "./HeroChat.astro";
import Pixels from "./Pixels.astro";
import Veil from "./Veil.astro";
import Icon from "./Icon.astro";
import { homeCopy, rich, phrase, command, type Lang } from "../lib/copy";
import { integrations, competitors, reviews, iva } from "../data/facts";
import { initials } from "../lib/pixels";
import { stats } from "../lib/stats";
const { lang = "en" } = Astro.props as { lang: Lang };
const ru = lang === "ru";
const c = homeCopy[lang];
const prefix = ru ? "/ru" : "";
const corners = ["tr", "bl", "tl", "br"] as const;
const opposite = { tr: "bl", bl: "tr", tl: "br", br: "tl" } as const;
// Arrow drawn from 3 px square pixels on a 7 x 7 grid; it steps forward on hover.
const arrow = [
  [0, 3], [1, 3], [2, 3], [3, 3], [4, 3], [5, 3], [6, 3],
  [5, 2], [4, 1], [3, 0], [5, 4], [4, 5], [3, 6],
];
const columns = [{ name: ru ? "Ива" : "Iva", values: iva }, ...competitors];
// Reviewers' initials drawn as a 5 x 7 pixel font: real people get no generated faces.
const monogram = (name: string) => initials(name.split(" ").map((w) => w[0]).join(""));
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Iva",
    url: "https://iva-agent.com",
    applicationCategory: "ProductivityApplication",
    operatingSystem: "Linux, macOS",
    description: c.description,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    license: "https://opensource.org/license/mit",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Majento",
    url: "https://majento.ai",
    logo: "https://iva-agent.com/brand/mark-512.png",
    sameAs: ["https://github.com/smixs/iva-agent"],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    inLanguage: lang,
    mainEntity: c.faq.items.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: f.answer.replace(/`/g, "") },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: c.final.h2,
    step: c.final.steps.map((s, i) => ({
      "@type": "HowToStep",
      position: i + 1,
      text: s,
    })),
  },
];
---

<Base
  lang={lang}
  title={c.title}
  description={c.description}
  en="/"
  ru="/ru/"
  schema={schema}
>
  <section class="hero wrap">
    <div class="hero-copy">
      <h1>
        {c.hero.h1.map((line) => <span>{line}</span>)}
      </h1>
      <p class="hero-lead">
        {c.hero.lead.map((line) => <span>{line} </span>)}
      </p>
      <div class="hero-cta">
        <button
          class="btn btn-cta"
          data-copy={phrase(lang)}
          aria-describedby="hero-hint"
        >
          {c.hero.cta}
          <span class="px-arrow" aria-hidden="true">{arrow.map(([x, y]) => <i style={`--x:${x};--y:${y}`}></i>)}</span>
          <Pixels seed={31} at="tr" count={9} cell={5} />
        </button>
        <p id="hero-hint" class="cta-hint">
          {c.hero.hint}{" "}
          <code>{phrase(lang).replace(/ (https:\S+)$/, "")} <span class="nowrap">{phrase(lang).match(/https:\S+$/)![0]}</span></code>
        </p>
        <p class="copy-status" role="status" aria-live="polite" data-copy-status>
        </p>
      </div>
      <ul class="hero-facts">
        {c.hero.facts.map((f) => <li>{f}</li>)}
      </ul>
      <div class="hero-stats">
        <a href="https://github.com/smixs/iva-agent">
          <Icon name="github" size={26} />
          <span><b>{stats.stars}</b> {c.hero.stars}</span>
        </a>
        <a href="https://github.com/smixs/iva-agent/releases">
          <Icon name="bars" size={26} />
          <span><b>{stats.releases}</b> {c.hero.releases}</span>
        </a>
      </div>
    </div>
    <div class="hero-visual" data-reveal>
      <svg class="hero-leaves" viewBox="0 0 760 680" aria-hidden="true">
        <defs>
          <linearGradient id="leaf-g" x1="0" y1="0" x2=".3" y2="1">
            <stop offset="0" stop-color="#b6e06a"></stop>
            <stop offset=".5" stop-color="#8cc84a"></stop>
            <stop offset="1" stop-color="#3f8c78"></stop>
          </linearGradient>
          <linearGradient id="leaf-b" x1="1" y1="0" x2=".2" y2="1">
            <stop offset="0" stop-color="#6db2ec"></stop>
            <stop offset="1" stop-color="#2a74bf"></stop>
          </linearGradient>
        </defs>
        <path
          class="leaf-green"
          fill="url(#leaf-g)"
          d="M190 650C110 560 40 440 32 300 26 200 30 100 44 20c106 50 206 140 256 270 40 110 0 250-110 360z"
        ></path>
        <path class="leaf-rib" d="M190 640C120 470 70 260 46 28"></path>
        <path
          class="leaf-blue"
          fill="url(#leaf-b)"
          d="M572 600c-24-110-6-232 52-322 28-44 58-78 92-104 16 116 4 220-34 300-28 58-64 100-110 126z"
        ></path>
      </svg>
      <Pixels seed={7} at="tl" count={12} cell={10} />
      <Pixels seed={9} at="tr" count={10} cell={10} edge />
      <Pixels seed={8} at="br" count={12} cell={10} />
      <HeroChat lang={lang} />
    </div>
  </section>

  <section id="features" class="cases wrap" aria-labelledby="cases-title">
    <span id="memory" class="legacy-anchor"></span>
    <h2 id="cases-title">{c.cases.h2}</h2>
    <ul class="case-grid">
      {
        c.cases.items.map((item, i) => (
          <li class="case" data-reveal data-glitch style={`--i:${i}`}>
            <figure class="case-media">
              <picture>
                <source
                  type="image/avif"
                  srcset={`/media/cases/${item.id}-800.avif 800w, /media/cases/${item.id}-1600.avif 1600w`}
                  sizes="(min-width: 1100px) 300px, (min-width: 640px) 45vw, 92vw"
                />
                <img
                  src={`/media/cases/${item.id}-800.webp`}
                  srcset={`/media/cases/${item.id}-800.webp 800w, /media/cases/${item.id}-1600.webp 1600w`}
                  sizes="(min-width: 1100px) 300px, (min-width: 640px) 45vw, 92vw"
                  alt={item.alt}
                  width="800"
                  height="600"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <Veil seed={100 + i} at={corners[i]} />
              <Pixels seed={200 + i} at={corners[i]} count={11} cell={14} edge />
              <Pixels seed={250 + i} at={opposite[corners[i]]} count={5} cell={14} />
            </figure>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="security" class="plate wrap" aria-labelledby="data-title">
    <div class="plate-inner" data-reveal data-glitch>
      <figure class="plate-media">
        <svg class="plate-leaf" viewBox="0 0 400 300" aria-hidden="true">
          <path
            d="M30 290C60 170 150 70 390 20 350 170 250 270 30 290z"></path>
          <path d="M30 290C140 200 250 110 390 20"></path>
        </svg>
        <picture>
          <source
            type="image/avif"
            srcset="/media/devices-800.avif 800w, /media/devices-1600.avif 1600w"
            sizes="(min-width: 900px) 460px, 90vw"
          />
          <img
            src="/media/devices-800.webp"
            srcset="/media/devices-800.webp 800w, /media/devices-1600.webp 1600w"
            sizes="(min-width: 900px) 460px, 90vw"
            alt={c.data.alt}
            width="800"
            height="549"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <Veil seed={300} at="bl" />
      </figure>
      <div class="plate-copy">
        <h2 id="data-title">{c.data.h2}</h2>
        <p class="plate-lead">
          {c.data.lead.map((line) => <span>{line} </span>)}
        </p>
        <ul class="plate-points">
          {
            c.data.points.map(([icon, text], i) => (
              <li>
                <span class="point-icon">
                  <Icon name={icon} size={30} />
                  <Pixels seed={400 + i} at="tr" count={6} cell={5} />
                </span>
                <span>{text}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="compare wrap" aria-labelledby="compare-title">
    <span id="pricing" class="legacy-anchor"></span>
    <h2 id="compare-title">{c.compare.h2}</h2>
    <div class="table-wrap" data-reveal role="region" tabindex="0" aria-label={c.compare.caption}>
      <table>
        <caption class="sr-only">{c.compare.caption}</caption>
        <colgroup>
          <col class="col-label" />
          {columns.map((_, i) => <col class:list={["col-value", { "col-iva": i === 0 }]} />)}
        </colgroup>
        <thead>
          <tr>
            <td></td>
            {
              columns.map((col, i) => (
                <th scope="col" class:list={[{ "is-iva": i === 0 }]}>
                  {col.name.split("\n").map((w, k) => (
                    <>
                      {k ? " " : ""}
                      <span>{w}</span>
                    </>
                  ))}
                  {i === 0 && <Pixels seed={500} at="tr" count={6} cell={6} />}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            c.compare.rows.map((row, r) => (
              <tr>
                <th scope="row">{row}</th>
                {columns.map((col, i) => {
                  const cell = col.values[r];
                  return (
                    <td class:list={[`is-${cell.v}`, { "is-iva": i === 0 }]}>
                      {cell.v === "unknown" ? (
                        !cell.note && <span class="cell-unknown">{c.compare.unknown}</span>
                      ) : (
                        <>
                          <Icon name={cell.v === "yes" ? "check" : "dash"} />
                          <span class="sr-only">{c.compare[cell.v]}</span>
                        </>
                      )}
                      {cell.note && <span class="cell-note">{cell.note[lang]}</span>}
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="compare-note">{c.compare.note}</p>
  </section>

  <section class="world wrap" aria-labelledby="world-title">
    <span id="works" class="legacy-anchor"></span>
    <span id="menu" class="legacy-anchor"></span>
    <span id="userbot" class="legacy-anchor"></span>
    <div class="world-apps">
      <h2 id="world-title">
        {c.world.h2.map((line) => <span>{line}</span>)}
      </h2>
      <ul class="logos" data-reveal>
        {
          integrations.map((app) => (
            <li style={`--brand:${app.color}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={app.d} />
              </svg>
              <span>{app[lang]}</span>
            </li>
          ))
        }
      </ul>
      <p class="world-line">{c.world.line}</p>
    </div>
    <div id="reviews" class="world-reviews">
      <span id="asks" class="legacy-anchor"></span>
      <ul class="review-list">
        {
          reviews.map((r, i) => (
            <li class="review" data-reveal data-glitch style={`--i:${i}`}>
              <span class="review-avatar" style={`--tone:${i ? "var(--blue)" : "var(--cta)"}`} aria-hidden="true">
                <svg viewBox={`0 0 ${monogram(r.name[lang]).w} 7`}>
                  {monogram(r.name[lang]).cells.map(([x, y], k) => (
                    <rect x={x} y={y} width="0.94" height="0.94" style={`--d:${(k * 37) % 420}ms`} />
                  ))}
                </svg>
                <Pixels seed={600 + i} at={i ? "br" : "tr"} count={8} cell={8} edge />
              </span>
              <blockquote>{ru ? `«${r.quote.ru}»` : `“${r.quote.en}”`}</blockquote>
              <a class="review-who" href={r.url}>
                {r.name[lang]} <span>{r.handle}</span>
                <span class="sr-only">, {c.world.source}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="world-caption">{c.world.reviewsLabel}</p>
    </div>
  </section>

  <section id="install" class="final wrap" aria-labelledby="final-title">
    <canvas class="px-field" data-px-field aria-hidden="true"></canvas>
    <div class="final-copy">
      <h2 id="final-title">{c.final.h2}</h2>
      <p>{c.final.text.map((line) => <span>{line} </span>)}</p>
      <div class="phrase">
        <code id="final-phrase" data-phrase>{phrase(lang)}</code>
      </div>
      <details class="other-ways">
        <summary>{c.final.other}<Icon name="plus" size={18} /></summary>
        <div class="other-body">
          <ol>
            {c.final.steps.map((s) => <li>{s}</li>)}
          </ol>
          <h3>{c.final.command}</h3>
          <p>{c.final.oneCommand} {c.final.mac}</p>
          <div class="phrase is-command">
            <code>{command}</code>
            <button class="btn-copy" data-copy={command}>
              <Icon name="copy" size={20} />
              <span>{c.final.copy}</span>
            </button>
          </div>
          <p class="copy-status" role="status" aria-live="polite" data-copy-status></p>
          <p class="other-links">
            <a href="https://github.com/smixs/iva-agent/blob/main/install.sh"
              >{c.final.script}</a
            >
            <a data-install-guide href={prefix + "/docs/install/"}>{c.final.guide}</a>
          </p>
        </div>
      </details>
    </div>
    <div class="final-action" data-reveal>
      <svg class="final-leaves" viewBox="0 0 240 210" aria-hidden="true">
        <path
          class="leaf-blue"
          d="M120 196C92 150 92 98 118 56 138 24 172 6 214 0c6 54-2 100-26 138-18 28-40 46-68 58z"
        ></path>
        <path
          class="leaf-green"
          d="M112 196C70 176 38 140 28 98 22 70 26 40 40 12c40 26 66 58 76 98 8 30 6 58-4 86z"
        ></path>
      </svg>
      <button
        class="btn btn-cta btn-xl"
        data-copy={phrase(lang)}
        aria-describedby="final-phrase"
      >
        {c.final.cta}
        <span class="px-arrow" aria-hidden="true">{arrow.map(([x, y]) => <i style={`--x:${x};--y:${y}`}></i>)}</span>
        <Pixels seed={32} at="tr" count={9} cell={5} />
      </button>
      <p class="copy-status" role="status" aria-live="polite" data-copy-status></p>
    </div>
  </section>

  <section id="faq" class="faq wrap">
    <div class="faq-head">
      <h2>{c.faq.h2}</h2>
      <span class="faq-px" data-reveal><Pixels seed={800} at="tl" count={10} cell={10} /></span>
    </div>
    <div class="faq-list">
      {
        c.faq.items.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <p set:html={rich(f.answer)} />
          </details>
        ))
      }
    </div>
  </section>
</Base>
<script>
  import "../scripts/motion";
</script>
