---
import Base from "../layouts/Base.astro";
import Scenes from "./Scenes.astro";
import HeroChat from "./HeroChat.astro";
import Mosaic from "./Mosaic.astro";
import Reviews from "./Reviews.astro";
import transcript from "../data/transcript.json";
import { homeCopy, rich, phrase, command, type Lang } from "../lib/copy";
import { stats } from "../lib/stats";
const { lang = "en" } = Astro.props as { lang: Lang };
const ru = lang === "ru";
const c = homeCopy[lang];
const group = (n: number, k: string) =>
  (c[n].groups as Record<string, string[]>)[k] || [];
const t = (n: number, k: string) => group(n, k)[0] || "";
const title = (n: number) => t(n, "H2");
const prefix = ru ? "/ru" : "";
const installLabel = ru
  ? "Установить с ИИ-агентом"
  : "Install with an AI agent";
const copyLabel = ru ? "Копировать" : "Copy";
const headingTerm = ru ? "AI‑ассистент" : "AI assistant";
const headingParts = t(1, "H1").split(headingTerm);
const trust = (s: string) =>
  s
    .replace("265", String(stats.stars))
    .replace("70", String(stats.releases))
    .replace(
      ru ? "11 участников" : "11 contributors",
      `${stats.contributors} ${ru ? "участников" : "contributors"}`,
    );
const faq = c[10].faq!;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Iva",
    url: "https://iva-agent.com",
    applicationCategory: "ProductivityApplication",
    operatingSystem: "Linux, macOS",
    description: t(0, "Description"),
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    license: "https://opensource.org/license/mit",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Majento",
    url: "https://majento.ai",
    logo: "https://iva-agent.com/brand/mark-512.png",
    sameAs: ["https://github.com/smixs/iva-agent"],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    inLanguage: lang,
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: f.answer.replace(/`/g, "") },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    name: title(3),
    description: t(3, "Текст"),
    duration: "PT78S",
    thumbnailUrl: "https://iva-agent.com/media/demo-poster.webp",
    contentUrl: "https://iva-agent.com/media/iva-demo-v5.mp4",
    uploadDate: "2026-10-23T09:20:00+05:00",
    inLanguage: "ru",
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: title(9),
    step: group(9, "Шаги").map((s, i) => ({
      "@type": "HowToStep",
      position: i + 1,
      text: s,
    })),
  },
];
---

<Base
  lang={lang}
  title={t(0, "Title")}
  description={t(0, "Description")}
  en="/"
  ru="/ru/"
  schema={schema}
>
  <section class="hero section">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="free-badge">FREE</span>
        {t(1, "Бейдж").replace("`FREE` ", "")}
      </p>
      <h1>
        {headingParts[0]}
        <span class="keep-words">{headingTerm}</span>
        {headingParts[1]}
      </h1>
      <p class="lead">{t(1, "Подзаголовок")}</p>
      <div class="actions">
        <button class="button" data-copy={phrase(lang)}>
          {installLabel}
          <span aria-hidden="true"> ↗</span>
        </button>
        <a class="button secondary" href="#video">
          {t(1, "Кнопки")
            .match(/\[([^\]]+)\]/g)![1]
            .slice(1, -1)}
        </a>
      </div>
      <p class="note" role="status" aria-live="polite" data-copy-status>
        {t(1, "Под кнопками")}
      </p>
    </div>
    <div class="hero-visual">
      <HeroChat lang={lang} />
    </div>
    <p class="trust">{trust(t(1, "Строка доверия"))}</p>
  </section>
  <Scenes lang={lang} title={title(2)} />
  <section id="video" class="section video-section">
    <div class="section-intro">
      <h2>{title(3)}</h2>
      <p>{t(3, "Текст")}</p>
    </div>
    <div class="video-layout">
      <video
        id="demo"
        width="1080"
        height="1080"
        preload="none"
        playsinline
        muted
        controls
        poster="/media/demo-poster.webp"
        aria-label={title(3)}
      >
        <source src="/media/iva-demo-v5.webm" type="video/webm" />
        <source src="/media/iva-demo-v5.mp4" type="video/mp4" />
      </video>
      <div class="chapters">
        {group(3, "Главы").map((ch, index) => {
          const [time, ...words] = ch.split(" ");

          return (
            <button data-seek={[3.5, 11, 20, 33, 48, 65.8][index]}>
              <span>{time}</span>
              {words.join(" ")}
              <span aria-hidden="true">↗</span>
            </button>
          );
        })}
      </div>
    </div>
  </section>
  <div class="section transcript">
    <details>
      <summary>{ru ? "Что в ролике" : "What's in the video"}</summary>
      {transcript[lang].map((scene) => (
        <div>
          <h3>{scene[0]}</h3>
          {scene.slice(1).map((line) => (
            <p>{line}</p>
          ))}
        </div>
      ))}
    </details>
  </div>
  <Reviews lang={lang} />
  <section id="pricing" class="section pricing">
    <div class="pricing-intro">
      <span class="free-display">FREE</span>
      <div>
        <h2>{title(5)}</h2>
        <p>{t(5, "Подзаголовок")}</p>
      </div>
    </div>
    <div class="prices">
      {group(5, "Три карточки: какую модель подключить").map((s) => (
        <article>
          <p set:html={rich(s)} />
        </article>
      ))}
    </div>
    <p>{t(5, "Строка под карточками")}</p>
    <a class="button" href="#install">
      {installLabel}
    </a>
  </section>
  <section id="more" class="section more-features">
    <span id="userbot" class="legacy-anchor" aria-hidden="true"></span>
    <span id="menu" class="legacy-anchor" aria-hidden="true"></span>
    <h2>{title(6)}</h2>
    <ul>
      {group(6, "H2")
        .slice(1)
        .map((s) => (
          <li>{s}</li>
        ))}
    </ul>
  </section>
  <section id="memory" class="section split">
    <div>
      <h2>{title(7)}</h2>
      <p>{t(7, "Текст")}</p>
    </div>
    <div class="memory-visual">
      <Mosaic scene="memory" />
      <div class="memory-flow">
        {(ru
          ? ["День", "Неделя", "Месяц", "Год", "Профиль"]
          : ["Day", "Week", "Month", "Year", "Profile"]
        ).map((s) => (
          <span>{s}</span>
        ))}
      </div>
    </div>
  </section>
  <section id="your-data" class="section split">
    <span id="security" class="legacy-anchor" aria-hidden="true"></span>
    <span id="works" class="legacy-anchor" aria-hidden="true"></span>
    <Mosaic scene="privacy" />
    <div>
      <h2>{title(8)}</h2>
      <ul class="plain-list">
        {group(8, "Пункты").map((s) => (
          <li>{s}</li>
        ))}
      </ul>
    </div>
  </section>
  <section id="install" class="section">
    <div class="section-intro">
      <h2>{title(9)}</h2>
    </div>
    <div class="install-layout">
      <div class="install-box">
        <div
          class="tabs"
          role="tablist"
          aria-label={ru ? "Способ установки" : "Installation method"}
        >
          {(ru
            ? ["С ИИ-агентом", "Одной командой", "На Mac"]
            : ["With an AI agent", "One command", "On Mac"]
          ).map((s, i) => (
            <button
              id={"tab-" + i}
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={"panel-" + i}
              tabindex={i === 0 ? 0 : -1}
              data-tab={i}
            >
              {s}
            </button>
          ))}
        </div>
        {[
          "Вкладка «С ИИ-агентом»",
          "Вкладка «Одной командой»",
          "Вкладка «На Mac»",
        ].map((key, i) => (
          <div
            class="install-panel"
            role="tabpanel"
            id={"panel-" + i}
            aria-labelledby={"tab-" + i}
          >
            <p set:html={rich(t(9, key))} />
            {i === 1 && (
              <a
                class="script-source"
                href="https://github.com/smixs/iva-agent/blob/main/install.sh"
              >
                {ru ? "Посмотреть скрипт" : "View the script"} ↗
              </a>
            )}
            <div class="command">
              <code>{i === 0 ? phrase(lang) : command}</code>
              <button
                data-copy={i === 0 ? phrase(lang) : command}
                aria-label={copyLabel}
              >
                {copyLabel}
              </button>
            </div>
          </div>
        ))}
        <a data-install-guide href={prefix + "/docs/install/"}>
          {ru ? "Инструкция по установке" : "Installation guide"} →
        </a>
        <p class="copy-feedback" aria-live="polite" data-copy-status></p>
        <ol class="install-steps">
          {group(9, "Шаги").map((s) => (
            <li>{s}</li>
          ))}
        </ol>
      </div>
      <Mosaic scene="install" />
    </div>
  </section>
  <section id="faq" class="section faq">
    <h2>{title(10)}</h2>
    <div>
      {faq.map((f) => (
        <details>
          <summary>{f.question}</summary>
          <p set:html={rich(f.answer)} />
        </details>
      ))}
    </div>
  </section>
  <section id="open-source" class="section open-source">
    <h2>{title(11)}</h2>
    <p class="project-stats">{trust(t(11, "Цифры"))}</p>
    <p>{t(11, "Текст")}</p>
    <div class="actions">
      <a href="https://github.com/smixs/iva-agent">GitHub ↗</a>
      <a href="https://github.com/smixs/iva-agent/blob/main/CHANGELOG.md">
        {ru ? "История изменений" : "Changelog"} ↗
      </a>
      <a href={prefix + "/about/"}>{ru ? "О команде" : "About the team"} →</a>
    </div>
  </section>
  <section class="section final-cta">
    <span class="free-badge">FREE</span>
    <h2>{title(12)}</h2>
    <div class="actions">
      <a class="button" href="#install">
        {installLabel}
      </a>
      <a class="button secondary" href="https://github.com/smixs/iva-agent">
        GitHub ↗
      </a>
    </div>
  </section>
</Base>
<script>
  const ru = document.documentElement.lang === "ru";
  const feedbackTimers = new WeakMap<HTMLElement, number>();
  document
    .querySelectorAll<HTMLButtonElement>("[data-copy]")
    .forEach((button) =>
      button.addEventListener("click", async () => {
        const isPrompt =
          button.dataset.copy ===
          document.querySelector("#panel-0 code")?.textContent;
        let feedback = button
          .closest("section")
          ?.querySelector<HTMLElement>("[data-copy-status]");
        let message = "";
        try {
          await navigator.clipboard.writeText(button.dataset.copy!);
          message = isPrompt
            ? ru
              ? "Скопировано. Вставьте в своего ИИ-агента."
              : "Copied. Paste it into your AI agent."
            : ru
              ? "Скопировано."
              : "Copied.";
          window.dispatchEvent(
            new CustomEvent("iva:analytics", {
              detail: { name: isPrompt ? "copy_prompt" : "copy_command" },
            }),
          );
        } catch {
          const index = isPrompt ? 0 : 1;
          activate(index);
          const target = document.querySelector(`#panel-${index} code`)!;
          const range = document.createRange();
          range.selectNodeContents(target);
          window.getSelection()?.removeAllRanges();
          window.getSelection()?.addRange(range);
          document.querySelector("#install")?.scrollIntoView();
          feedback = document.querySelector(".copy-feedback")!;
          message = ru
            ? "Не удалось скопировать. Выделите текст и скопируйте вручную."
            : "Could not copy. Select the text and copy it manually.";
        }
        if (feedback) {
          const original =
            feedback.dataset.originalMessage ?? feedback.textContent ?? "";
          feedback.dataset.originalMessage = original;
          window.clearTimeout(feedbackTimers.get(feedback));
          feedback.setAttribute("aria-live", "polite");
          feedback.textContent = message;
          feedbackTimers.set(
            feedback,
            window.setTimeout(() => {
              feedback!.textContent = original;
            }, 4000),
          );
        }
      }),
    );
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-tab]")];
  function activate(index: number, track = false) {
    if (track)
      window.dispatchEvent(
        new CustomEvent("iva:analytics", {
          detail: {
            name: "install_tab",
            method: ["agent", "curl", "mac"][index],
          },
        }),
      );
    tabs.forEach((tab, i) => {
      tab.setAttribute("aria-selected", String(i === index));
      tab.tabIndex = i === index ? 0 : -1;
      document.getElementById("panel-" + i)!.hidden = i !== index;
    });
  }
  activate(0);
  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => activate(i, true));
    tab.addEventListener("keydown", (event) => {
      let next = i;
      if (event.key === "ArrowRight") next = (i + 1) % tabs.length;
      else if (event.key === "ArrowLeft")
        next = (i + tabs.length - 1) % tabs.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = tabs.length - 1;
      else return;
      event.preventDefault();
      activate(next, true);
      tabs[next].focus();
    });
  });
  const video = document.querySelector<HTMLVideoElement>("#demo")!;
  video.addEventListener("play", () =>
    window.dispatchEvent(
      new CustomEvent("iva:analytics", { detail: { name: "video_play" } }),
    ),
  );
  function updateChapter() {
    const buttons = [
      ...document.querySelectorAll<HTMLButtonElement>("[data-seek]"),
    ];
    const index = buttons.findLastIndex(
      (b) => Number(b.dataset.seek) <= video.currentTime + 0.05,
    );
    buttons.forEach((button, i) => {
      button.classList.toggle("active", i === index);
      if (i === index) button.setAttribute("aria-current", "true");
      else button.removeAttribute("aria-current");
    });
  }
  video.addEventListener("timeupdate", updateChapter);
  video.addEventListener("seeked", updateChapter);
  document.querySelectorAll("[data-install-guide]").forEach((link) =>
    link.addEventListener("click", () =>
      window.dispatchEvent(
        new CustomEvent("iva:analytics", {
          detail: { name: "open_install_guide" },
        }),
      ),
    ),
  );
  document
    .querySelectorAll<HTMLButtonElement>("[data-seek]")
    .forEach((button) =>
      button.addEventListener("click", () => {
        const video = document.querySelector<HTMLVideoElement>("#demo")!;
        video.currentTime = Number(button.dataset.seek);
        updateChapter();
        window.dispatchEvent(
          new CustomEvent("iva:analytics", {
            detail: { name: "video_chapter", chapter: video.currentTime },
          }),
        );
        video.play().catch(() => {});
      }),
    );
</script>
