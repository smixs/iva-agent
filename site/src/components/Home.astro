---
import Base from "../layouts/Base.astro";
import UseCases from "./UseCases.astro";
import HeroChat from "./HeroChat.astro";
import { extras } from "../data/home-extras";
import Mosaic from "./Mosaic.astro";
import Reviews from "./Reviews.astro";
import { homeCopy, rich, phrase, command, type Lang } from "../lib/copy";
const { lang = "en" } = Astro.props as { lang: Lang };
const ru = lang === "ru";
const c = Object.fromEntries(
  homeCopy[lang].map((section) => [section.number, section]),
);
const group = (n: number, k: string) =>
  (c[n].groups as Record<string, string[]>)[k] || [];
const t = (n: number, k: string) => group(n, k)[0] || "";
const title = (n: number) => t(n, "H2");
const prefix = ru ? "/ru" : "";
const installLabel = ru
  ? "Установить с ИИ-агентом"
  : "Install with an AI agent";
const copyLabel = ru ? "Копировать" : "Copy";
const headingTerm = ru ? "AI‑ассистент" : "AI assistant";
const headingParts = t(1, "H1").split(headingTerm);
const faq = c[10].faq!;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Iva",
    url: "https://iva-agent.com",
    applicationCategory: "ProductivityApplication",
    operatingSystem: "Linux, macOS",
    description: t(0, "Description"),
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    license: "https://opensource.org/license/mit",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Majento",
    url: "https://majento.ai",
    logo: "https://iva-agent.com/brand/mark-512.png",
    sameAs: ["https://github.com/smixs/iva-agent"],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    inLanguage: lang,
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: f.answer.replace(/`/g, "") },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: title(9),
    step: group(9, "Шаги").map((s, i) => ({
      "@type": "HowToStep",
      position: i + 1,
      text: s,
    })),
  },
];
---

<Base
  lang={lang}
  title={t(0, "Title")}
  description={t(0, "Description")}
  en="/"
  ru="/ru/"
  schema={schema}
>
  <section class="hero section">
    <div class="hero-copy">
      <h1>
        {headingParts[0]}
        <span class="keep-words">{headingTerm}</span>
        {headingParts[1]}
      </h1>
      <p class="lead">{t(1, "Подзаголовок")}</p>
      <div class="actions">
        <button class="button" data-copy={phrase(lang)}>
          {installLabel}
        </button>
      </div>
    </div>
    <div class="hero-visual">
      <HeroChat lang={lang} />
    </div>
  </section>
  <UseCases lang={lang} title={title(2)} />
  <Reviews lang={lang} />
  <section id="pricing" class="section pricing">
    <div class="pricing-intro">
      <span class="free-display">FREE</span>
      <div>
        <h2>{title(5)}</h2>
        <p>{t(5, "Подзаголовок")}</p>
      </div>
    </div>
  </section>
  <section id="your-data" class="section split">
    <span id="security" class="legacy-anchor" aria-hidden="true"></span>
    <span id="works" class="legacy-anchor" aria-hidden="true"></span>
    <Mosaic scene="privacy" />
    <div>
      <h2>{title(8)}</h2>
      <ul class="plain-list">
        {group(8, "Пункты").map((s) => (
          <li>{s}</li>
        ))}
      </ul>
    </div>
  </section>
  <section id="install" class="section">
    <div class="section-intro">
      <h2>{title(9)}</h2>
    </div>
    <div class="install-layout">
      <div class="install-box">
        <div
          class="tabs"
          role="tablist"
          aria-label={ru ? "Способ установки" : "Installation method"}
        >
          {(ru
            ? ["С ИИ-агентом", "Одной командой", "На Mac"]
            : ["With an AI agent", "One command", "On Mac"]
          ).map((s, i) => (
            <button
              id={"tab-" + i}
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={"panel-" + i}
              tabindex={i === 0 ? 0 : -1}
              data-tab={i}
            >
              {s}
            </button>
          ))}
        </div>
        {[
          "Вкладка «С ИИ-агентом»",
          "Вкладка «Одной командой»",
          "Вкладка «На Mac»",
        ].map((key, i) => (
          <div
            class="install-panel"
            role="tabpanel"
            id={"panel-" + i}
            aria-labelledby={"tab-" + i}
          >
            <p set:html={rich(t(9, key))} />
            {i === 1 && (
              <a
                class="script-source"
                href="https://github.com/smixs/iva-agent/blob/main/install.sh"
              >
                {ru ? "Посмотреть скрипт" : "View the script"} ↗
              </a>
            )}
            <div class="command">
              <code>{i === 0 ? phrase(lang) : command}</code>
              <button
                data-copy={i === 0 ? phrase(lang) : command}
                aria-label={copyLabel}
              >
                {copyLabel}
              </button>
            </div>
          </div>
        ))}
        <a data-install-guide href={prefix + "/docs/install/"}>
          {ru ? "Инструкция по установке" : "Installation guide"} →
        </a>
        <ol class="install-steps">
          {group(9, "Шаги").map((s) => (
            <li>{s}</li>
          ))}
        </ol>
      </div>
      <Mosaic scene="install" />
    </div>
  </section>
  <section id="faq" class="section faq">
    <h2>{title(10)}</h2>
    <div>
      {faq.map((f) => (
        <details>
          <summary>{f.question}</summary>
          <p set:html={rich(f.answer)} />
        </details>
      ))}
    </div>
  </section>
  <section class="section final-cta">
    <h2>{title(12)}</h2>
    <div class="actions">
      <button class="button" data-copy={phrase(lang)}>
        {extras[lang].start}
      </button>
      <a class="button secondary" href="https://github.com/smixs/iva-agent">
        GitHub ↗
      </a>
    </div>
  </section>
  <p class="toast" role="status" aria-live="polite" data-toast></p>
</Base>
<script>
  const ru = document.documentElement.lang === "ru";
  // Copy the phrase or the command and say so in a toast that leaves by itself.
  // If the clipboard is closed, the toast shows the text to copy by hand.
  const toast = document.querySelector<HTMLElement>("[data-toast]")!;
  let toastTimer = 0;
  function say(message: string, ms: number, long = false) {
    toast.textContent = message;
    toast.classList.toggle("is-long", long);
    toast.classList.add("is-on");
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove("is-on"), ms);
  }
  document
    .querySelectorAll<HTMLButtonElement>("[data-copy]")
    .forEach((button) =>
      button.addEventListener("click", async () => {
        const text = button.dataset.copy!;
        const isPrompt = text.includes("install.txt");
        try {
          await navigator.clipboard.writeText(text);
          say(
            isPrompt
              ? ru
                ? "Фраза скопирована — отправьте её Claude Code или Codex"
                : "Phrase copied — send it to Claude Code or Codex"
              : ru
                ? "Команда скопирована"
                : "Command copied",
            3200,
          );
          window.dispatchEvent(
            new CustomEvent("iva:analytics", {
              detail: { name: isPrompt ? "copy_prompt" : "copy_command" },
            }),
          );
        } catch {
          say((ru ? "Скопируйте вручную: " : "Copy by hand: ") + text, 9000, true);
        }
      }),
    );
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-tab]")];
  function activate(index: number, track = false) {
    if (track)
      window.dispatchEvent(
        new CustomEvent("iva:analytics", {
          detail: {
            name: "install_tab",
            method: ["agent", "curl", "mac"][index],
          },
        }),
      );
    tabs.forEach((tab, i) => {
      tab.setAttribute("aria-selected", String(i === index));
      tab.tabIndex = i === index ? 0 : -1;
      document.getElementById("panel-" + i)!.hidden = i !== index;
    });
  }
  activate(0);
  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => activate(i, true));
    tab.addEventListener("keydown", (event) => {
      let next = i;
      if (event.key === "ArrowRight") next = (i + 1) % tabs.length;
      else if (event.key === "ArrowLeft")
        next = (i + tabs.length - 1) % tabs.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = tabs.length - 1;
      else return;
      event.preventDefault();
      activate(next, true);
      tabs[next].focus();
    });
  });
  document.querySelectorAll("[data-install-guide]").forEach((link) =>
    link.addEventListener("click", () =>
      window.dispatchEvent(
        new CustomEvent("iva:analytics", {
          detail: { name: "open_install_guide" },
        }),
      ),
    ),
  );
</script>
