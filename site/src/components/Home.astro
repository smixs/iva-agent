---
import Base from "../layouts/Base.astro";
import UseCases from "./UseCases.astro";
import Connections from "./Connections.astro";
import HeroChat from "./HeroChat.astro";
import Leaves from "./Leaves.astro";
import Reviews from "./Reviews.astro";
import Willow from "./Willow.astro";
import { homeCopy, rich, phrase, glue, type Lang } from "../lib/copy";
import { sprite } from "../lib/services";
const { lang = "en" } = Astro.props as { lang: Lang };
const ru = lang === "ru";
const c = Object.fromEntries(
  homeCopy[lang].map((section) => [section.number, section]),
);
const group = (n: number, k: string) =>
  ((c[n].groups as Record<string, string[]>)[k] || []).map((s) =>
    // Section 0 is the page title and description: plain text, no typesetting.
    n === 0 ? s : glue(s),
  );
const t = (n: number, k: string) => group(n, k)[0] || "";
const title = (n: number) => t(n, "H2");
// The price heading leads with its first word in green: "Free", "Бесплатно".
const [, free, forever] = title(7).match(/^(\p{L}+)([\s\S]*)$/u) || ["", "", title(7)];
const installLabel = t(1, "Кнопки");
const headline = group(1, "H1");
const faq = c[10].faq!;
const docs = ru ? "/ru/docs/" : "/docs/";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Iva",
    url: "https://iva-agent.com",
    applicationCategory: "ProductivityApplication",
    operatingSystem: "Linux, macOS",
    description: t(0, "Description"),
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    license: "https://opensource.org/license/mit",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Majento",
    url: "https://majento.ai",
    logo: "https://iva-agent.com/brand/mark-512.png",
    sameAs: ["https://github.com/smixs/iva-agent"],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    inLanguage: lang,
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: f.answer.replace(/`/g, "") },
    })),
  },
];
---

<Base
  lang={lang}
  title={t(0, "Title")}
  description={t(0, "Description")}
  en="/"
  ru="/ru/"
  schema={schema}
  intro
>
  <Leaves splash />
  <section class="hero section" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title" class="hero-heading">
        {headline.map((line) => <span>{line}</span>)}
      </h1>
      <div class="hero-intro">
        <p class="lead">{t(1, "Подзаголовок")}</p>
        <div class="actions">
          <button class="button" data-copy={phrase(lang)}>{installLabel}</button>
        </div>
      </div>
    </div>
    <div class="hero-visual">
      <HeroChat lang={lang} />
    </div>
  </section>
  <script is:inline>
    // Opening, once per session (decided in Base.astro before the first paint). In order, never
    // overlapping: one leaf sprouts mid-screen and the second opens out of it, turning blue; the
    // mark crouches, then flies on an arc into its place behind the phone, growing, still sharp;
    // then the phone and the page come in, and only under the risen phone does the mark soften
    // into the blurred leaves (Leaves.astro). The flight is measured after the web fonts settle,
    // so the target stays put.
    (() => {
      const root = document.documentElement;
      if (root.dataset.intro !== "play") return;
      try { sessionStorage.setItem("iva-intro", "1"); } catch {}
      const splash = document.querySelector("[data-intro-mark]");
      const leaves = document.querySelector("[data-leaves]");
      const input = new AbortController();
      const done = () => {
        if (root.dataset.intro === "done") return;
        input.abort();
        root.dataset.intro = "done";
        dispatchEvent(new Event("iva:intro-done"));
      };
      // Any scroll, tap or key ends the opening at once: the page never waits on its own show.
      for (const type of ["wheel", "touchstart", "pointerdown", "keydown", "scroll"]) addEventListener(type, done, { passive: true, signal: input.signal });
      setTimeout(done, 8000);
      if (!splash || !leaves || !splash.animate) return done();
      const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
      const ended = (animations) => Promise.all(animations.map((a) => a.finished));
      const land = () => {
        if (root.dataset.intro !== "fly") return;
        root.dataset.intro = "land";
        // The opening ends when the phone and the page have come in.
        ended(document.getAnimations().filter((a) => /^(iva-intro|v7-phone-rise|v7-fade-in)/.test(a.animationName || ""))).then(done, done);
      };
      const fly = () => {
        if (root.dataset.intro !== "play") return;
        root.dataset.intro = "fly";
        // Land exactly on the leaves, which start sharp, so the swap at the end is invisible. The
        // leaves may be turned (narrow screens), so take their box before the turn and turn with it.
        const from = splash.getBoundingClientRect();
        const wrap = leaves.offsetParent.getBoundingClientRect();
        const turn = parseFloat(getComputedStyle(leaves).rotate) || 0;
        const w = from.width / 2, h = from.height / 2, end = leaves.offsetHeight / from.height;
        // Centres of the mark: here, after the crouch, and on the leaves. The arc bends upwards.
        const c0 = [from.left + w, from.top + h];
        const c2 = [wrap.left + leaves.offsetLeft + w * end, wrap.top + leaves.offsetTop + h * end];
        const span = Math.hypot(c2[0] - c0[0], c2[1] - c0[1]) || 1;
        const dir = [(c2[0] - c0[0]) / span, (c2[1] - c0[1]) / span];
        const reach = h * 0.45;
        const c1 = [c0[0] - dir[0] * reach, c0[1] - dir[1] * reach];
        const up = dir[0] >= 0 ? [dir[1], -dir[0]] : [-dir[1], dir[0]];
        const bend = [(c1[0] + c2[0]) / 2 + up[0] * span * 0.28, (c1[1] + c2[1]) / 2 + up[1] * span * 0.28];
        const D = 1400, A = 260;
        // Pose at a moment: centre, scale, turn. Anticipation first: the mark draws back against the
        // flight, a little smaller and squashed along it, winding up its turn. Then the flight: out
        // fast, slowing into the place, a touch past it and back; the turn swings and dies out. The
        // mark grows by equal ratios (slowly at first, as a thing far away), a little past its size
        // near the end, and settles.
        const pose = (ms) => {
          if (ms < A) {
            const k = 0.5 - 0.5 * Math.cos((Math.PI * ms) / A);
            return { c: [c0[0] - dir[0] * reach * k, c0[1] - dir[1] * reach * k], s: 1 - 0.08 * k, r: -8 * k, squash: 1 - 0.2 * k, x: 0 };
          }
          const x = (ms - A) / (D - A), u = x - 1, q = 1 + 2 * u * u * u + u * u, v = 1 - q;
          const grow = x < 0.5 ? 2 * x * x : 1 - 2 * u * u;
          const past = x > 0.55 ? 0.035 * Math.sin((Math.PI * (x - 0.55)) / 0.45) : 0;
          return {
            c: [v * v * c1[0] + 2 * v * q * bend[0] + q * q * c2[0], v * v * c1[1] + 2 * v * q * bend[1] + q * q * c2[1]],
            s: 0.92 * (end / 0.92) ** grow * (1 + past),
            r: -8 + (turn + 8) * q + 8 * Math.sin(2 * Math.PI * x) * (1 - x) ** 1.5,
            x,
          };
        };
        // Each frame stretches the mark along its motion by its speed (sizes per frame), squashing it
        // across, so its volume stays; at rest it is its own shape again.
        const frames = [];
        for (let i = 0, n = Math.ceil(D / 16); i <= n; i++) {
          const ms = Math.min(D, i * 16), p = pose(ms);
          const a = pose(Math.max(0, ms - 8)).c, b = pose(ms + 8).c;
          const run = Math.hypot(b[0] - a[0], b[1] - a[1]) / 16;
          const angle = ms < A ? Math.atan2(dir[1], dir[0]) : Math.atan2(b[1] - a[1], b[0] - a[0]);
          const stretch = ms < A ? p.squash : ms === D ? 1 : 1 + Math.min(0.24, (16 * run) / (p.s * from.height));
          frames.push({
            offset: ms / D,
            transform: `translate(${p.c[0] - p.s * w - from.left}px, ${p.c[1] - p.s * h - from.top}px) scale(${p.s}) translate(${w}px, ${h}px) rotate(${angle}rad) scale(${stretch}, ${1 / stretch}) rotate(${-angle}rad) rotate(${p.r}deg) translate(${-w}px, ${-h}px)`,
          });
        }
        splash.style.transformOrigin = "0 0";
        splash.animate(frames, { duration: D, fill: "forwards" }).finished.then(land, done);
        // Overlapping action: as the mark sets off, its leaves swing against each other and settle.
        const swing = (el, deg) => el.animate([0, deg, -deg * 0.45, deg * 0.15, 0].map((d, i) => ({ offset: [0, 0.25, 0.55, 0.8, 1][i], transform: `rotate(${d}deg)`, easing: "cubic-bezier(.45,0,.55,1)" })), { duration: 800, delay: A });
        for (const el of splash.querySelectorAll(".iva-leaf-g, .iva-leaf-full")) swing(el, 3);
        swing(splash.querySelector(".iva-leaf-b"), -7);
      };
      // The second leaf has opened (Leaves.astro) and held for a moment, and the fonts are in.
      const opened = ended(splash.querySelector(".iva-leaf-b").getAnimations()).then(() => wait(120));
      const fonts = Promise.race([document.fonts ? document.fonts.ready : wait(0), wait(2500)]);
      Promise.all([opened, fonts]).then(fly, done);
    })();
  </script>
  <UseCases lang={lang} />
  <Reviews lang={lang} label={t(6, "Label")} />
  <Connections lang={lang} title={title(3)} line={t(3, "Подзаголовок")} link={t(3, "Ссылка")} />
  <section id="price" class="section price" aria-labelledby="price-title">
    {["configuration", "menu", "security"].map((id) => <span id={id} class="legacy-anchor" aria-hidden="true"></span>)}
    <div class="price-copy">
      <h2 id="price-title"><span class="price-free">{free}</span>{forever}</h2>
      <p class="price-line">{t(7, "Подзаголовок")}</p>
      <p class="price-note">{t(7, "Условия")}</p>
    </div>
    <Willow />
  </section>
  <section id="install" class="install-band" aria-labelledby="install-title">
    <div class="section install">
      <h2 id="install-title">{title(9)}</h2>
      <p>{t(9, "Подзаголовок")}</p>
      <div class="install-actions">
        <button class="button" data-copy={phrase(lang)}>{t(9, "Кнопки")}</button>
        <a class="text-link" href={docs + "install/"}>{t(9, "Ссылка")}</a>
      </div>
    </div>
  </section>
  <section id="faq" class="section faq" aria-labelledby="faq-title">
    <span id="pricing" class="legacy-anchor" aria-hidden="true"></span>
    <span id="works" class="legacy-anchor" aria-hidden="true"></span>
    <details class="faq-group">
      <summary class="faq-heading"><h2 id="faq-title">{title(10)}</h2><span class="faq-toggle" aria-hidden="true"></span></summary>
      <div class="faq-list">
      {faq.map((f) => (
        <details>
          <summary class="faq-question">{f.question}<span class="faq-toggle" aria-hidden="true"></span></summary>
          <p set:html={rich(f.answer)} />
        </details>
      ))}
      </div>
    </details>
  </section>
  <p class="toast" role="status" aria-live="polite" data-toast></p>
  <Fragment set:html={sprite} />
</Base>
<script>
  const ru = document.documentElement.lang === "ru";
  // Copy the install phrase and say so in a toast that leaves by itself.
  // If the clipboard is closed, the toast shows the phrase to copy by hand.
  const toast = document.querySelector<HTMLElement>("[data-toast]")!;
  let toastTimer = 0;
  function say(message: string, ms: number, long = false) {
    toast.textContent = message;
    toast.classList.toggle("is-long", long);
    toast.classList.add("is-on");
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove("is-on"), ms);
  }
  document.addEventListener("click", async (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("button[data-copy]");
    if (!button) return;
    const text = button.dataset.copy!;
    const inDemo = Boolean(button.closest("[data-demo]"));
    try {
      await navigator.clipboard.writeText(text);
      if (!inDemo) say(ru ? "Фраза скопирована. Отправьте её Claude Code или Codex" : "Phrase copied. Send it to Claude Code or Codex", 3200);
      button.dispatchEvent(new CustomEvent("iva:copy-result", { bubbles: true, detail: { ok: true, text } }));
      window.dispatchEvent(new CustomEvent("iva:analytics", { detail: { name: "copy_prompt" } }));
    } catch {
      if (!inDemo) say((ru ? "Скопируйте вручную: " : "Copy by hand: ") + text, 9000, true);
      button.dispatchEvent(new CustomEvent("iva:copy-result", { bubbles: true, detail: { ok: false, text } }));
    }
  });
</script>
