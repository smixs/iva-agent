---
import Base from "../layouts/Base.astro";
import UseCases from "./UseCases.astro";
import Connections from "./Connections.astro";
import HeroChat from "./HeroChat.astro";
import Reviews from "./Reviews.astro";
import { homeCopy, rich, phrase, type Lang } from "../lib/copy";
const { lang = "en" } = Astro.props as { lang: Lang };
const ru = lang === "ru";
const c = Object.fromEntries(
  homeCopy[lang].map((section) => [section.number, section]),
);
const group = (n: number, k: string) =>
  (c[n].groups as Record<string, string[]>)[k] || [];
const t = (n: number, k: string) => group(n, k)[0] || "";
const title = (n: number) => t(n, "H2");
const installLabel = ru
  ? "Установить с ИИ-агентом"
  : "Install with an AI agent";
const headingTerm = ru ? "AI‑ассистент" : "AI assistant";
const headingParts = t(1, "H1").split(headingTerm);
const faq = c[10].faq!;
// Line icons for the three security points: open code, visible actions, allowed people.
const securityIcons = [
  ["M8.5 8 4.5 12l4 4", "M15.5 8l4 4-4 4", "M13.5 5.5l-3 13"],
  ["M12 3.2 5 6v5.4c0 4.4 2.9 7.9 7 9.4 4.1-1.5 7-5 7-9.4V6z", "M8.8 12.1l2.3 2.3 4.3-4.6"],
  ["M6 10.5h12v9.5H6z", "M8.5 10.5V7.8a3.5 3.5 0 0 1 7 0v2.7", "M12 14.2v2.4"],
];
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Iva",
    url: "https://iva-agent.com",
    applicationCategory: "ProductivityApplication",
    operatingSystem: "Linux, macOS",
    description: t(0, "Description"),
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    license: "https://opensource.org/license/mit",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Majento",
    url: "https://majento.ai",
    logo: "https://iva-agent.com/brand/mark-512.png",
    sameAs: ["https://github.com/smixs/iva-agent"],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    inLanguage: lang,
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: f.answer.replace(/`/g, "") },
    })),
  },
];
---

<Base
  lang={lang}
  title={t(0, "Title")}
  description={t(0, "Description")}
  en="/"
  ru="/ru/"
  schema={schema}
>
  <section class="hero section">
    <div class="hero-copy">
      <h1>
        {headingParts[0]}
        <span class="keep-words">{headingTerm}</span>
        {headingParts[1]}
      </h1>
      <p class="lead">{t(1, "Подзаголовок")}</p>
      <div class="actions">
        <button class="button" data-copy={phrase(lang)}>
          {installLabel}
        </button>
      </div>
    </div>
    <div class="hero-visual">
      <HeroChat lang={lang} />
    </div>
  </section>
  <UseCases lang={lang} title={title(2)} />
  <Connections lang={lang} title={title(3)} line={t(3, "Подзаголовок")} />
  <Reviews lang={lang} title={title(4)} />
  <section id="pricing" class="section pricing">
    <div class="pricing-intro">
      <span class="free-display">FREE</span>
      <div>
        <h2>{title(5)}</h2>
        <p>{t(5, "Подзаголовок")}</p>
      </div>
    </div>
  </section>
  <section id="security" class="section security">
    <span id="works" class="legacy-anchor" aria-hidden="true"></span>
    <h2>{title(8)}</h2>
    <p class="lead">{t(8, "Подзаголовок")}</p>
    <ul class="security-points">
      {group(8, "Пункты").map((s, i) => (
        <li>
          <svg
            viewBox="0 0 24 24"
            width="28"
            height="28"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            {securityIcons[i].map((d) => (
              <path d={d} />
            ))}
          </svg>
          {s}
        </li>
      ))}
    </ul>
  </section>
  <section id="install" class="section install">
    <h2>{title(9)}</h2>
    <button class="button" data-copy={phrase(lang)}>
      {installLabel}
    </button>
  </section>
  <section id="faq" class="section faq">
    <h2>{title(10)}</h2>
    <div>
      {faq.map((f) => (
        <details>
          <summary>{f.question}</summary>
          <p set:html={rich(f.answer)} />
        </details>
      ))}
    </div>
  </section>
  <p class="toast" role="status" aria-live="polite" data-toast></p>
</Base>
<script>
  const ru = document.documentElement.lang === "ru";
  // Copy the install phrase and say so in a toast that leaves by itself.
  // If the clipboard is closed, the toast shows the phrase to copy by hand.
  const toast = document.querySelector<HTMLElement>("[data-toast]")!;
  let toastTimer = 0;
  function say(message: string, ms: number, long = false) {
    toast.textContent = message;
    toast.classList.toggle("is-long", long);
    toast.classList.add("is-on");
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove("is-on"), ms);
  }
  document
    .querySelectorAll<HTMLButtonElement>("[data-copy]")
    .forEach((button) =>
      button.addEventListener("click", async () => {
        const text = button.dataset.copy!;
        try {
          await navigator.clipboard.writeText(text);
          say(
            ru
              ? "Фраза скопирована — отправьте её Claude Code или Codex"
              : "Phrase copied — send it to Claude Code or Codex",
            3200,
          );
          window.dispatchEvent(
            new CustomEvent("iva:analytics", { detail: { name: "copy_prompt" } }),
          );
        } catch {
          say((ru ? "Скопируйте вручную: " : "Copy by hand: ") + text, 9000, true);
        }
      }),
    );
</script>
