---
import type { Lang } from "../lib/copy";
const {
  lang = "en",
  variant = "hero",
  index = 0,
} = Astro.props as { lang?: Lang; variant?: string; index?: number };
const ru = lang === "ru";
const scenarios = ru
  ? [
      [
        "Голосовое · 0:23",
        "Записала 3 задачи: смета для Анны, оплатить хостинг, купить корм коту.",
      ],
      [
        "Что мы решили с Анной по срокам?",
        "14 октября договорились: первая версия к 1 ноября, правки неделю.",
      ],
      [
        "Что сегодня?",
        "В 11:00 созвон с Анной. Счёт поставщику до 18:00. Черновик сметы готов.",
      ],
      ["Собери КП из прайса", "КП готово. Скидка на 2,5% ниже. Google Doc ↗"],
      [
        "Скажи, когда ответят про возврат",
        "Авиакомпания ответила. Возврат одобрен, деньги придут в течение недели.",
      ],
      [
        "Найди источники для обзора",
        "Нашла 4 исследования. Собрала выводы и ссылки в документ.",
      ],
    ]
  : [
      [
        "Voice note · 0:23",
        "Saved 3 tasks: a quote for Anna, pay for hosting, buy cat food.",
      ],
      [
        "What did we agree with Anna?",
        "On October 14: first version by November 1, then a week for revisions.",
      ],
      [
        "What's on today?",
        "Call with Anna at 11:00. Supplier invoice by 18:00. Your draft quote is ready.",
      ],
      [
        "Make a quote from this price list",
        "Your quote is ready. 2.5% less discount. Google Doc ↗",
      ],
      [
        "Tell me when they answer about the refund",
        "The airline replied. Refund approved, the money will arrive within a week.",
      ],
      [
        "Find sources for the review",
        "Found 4 studies. Conclusions and links are in the document.",
      ],
    ];
---

<div
  class:list={[
    "tg",
    { "tg-mini": variant === "mini", "tg-notices": variant === "notices" },
  ]}
  role="group"
  aria-label={
    ru
      ? "Пример переписки с Ивой, выдуманные данные"
      : "Example conversation with Iva, fictional data"
  }
>
  <div class="tg-head">
    <img src="/brand/mark.svg" width="36" height="36" alt="" />
    <div>
      <strong>{ru ? "Ива" : "Iva"}</strong>
      <small>{ru ? "бот · на вашем сервере" : "bot · on your server"}</small>
    </div>
    <span class="tg-dots" aria-hidden="true">
      ···
    </span>
  </div>
  <div class="tg-body">
    {variant === "mini" ? (
      <>
        <div class="msg outgoing">{scenarios[index][0]}</div>
        <div class="msg incoming">
          {scenarios[index][1]}
          <small>09:14</small>
        </div>
      </>
    ) : variant === "notices" ? (
      <>
        <div class="msg incoming">
          <b>{ru ? "Обзор дня" : "Daily brief"}</b>
          <p>{scenarios[2][1]}</p>
          <small>08:30</small>
        </div>
        <div class="msg incoming">
          {ru
            ? "Анна ждёт ответа 2 дня. Черновик сметы готов."
            : "Anna has been waiting for 2 days. Your draft quote is ready."}
          <small>10:20</small>
        </div>
        <div class="msg incoming">
          {ru
            ? "Помощник закончил разбор договора. Нашла 3 пункта, которые стоит обсудить."
            : "Your helper finished reviewing the contract. Found 3 points to discuss."}
          <small>14:00</small>
        </div>
      </>
    ) : (
      <>
        <div class="tg-day">{ru ? "Сегодня" : "Today"}</div>
        <div class="msg incoming">
          <span class="chip">{ru ? "Утро" : "Morning"}</span>{" "}
          {ru
            ? "Доброе утро. Сегодня: созвон с Анной в 11:00, счёт поставщику до 18:00. Анна вчера просила прислать смету, я подготовила черновик."
            : "Good morning. Today: a call with Anna at 11:00, a supplier invoice by 18:00. Anna asked for a quote yesterday. I prepared a draft."}
          <small>08:30</small>
        </div>
        <div class="msg outgoing voice">
          <span aria-hidden="true">▶</span>
          <div>
            <div class="wave" aria-hidden="true">
              {Array.from({ length: 34 }, (_, i) => (
                <i
                  style={`height:${6 + Math.round(18 * Math.abs(Math.sin(i * 1.7) * Math.cos(i * 0.6)))}px`}
                />
              ))}
            </div>
            <small>0:23</small>
          </div>
          <small>09:12 ✓✓</small>
        </div>
        <div class="msg incoming">
          {ru ? "Записала 3 задачи:" : "Saved 3 tasks:"}
          <ul>
            <li>
              {ru ? "смета для Анны, к 11:00" : "quote for Anna, by 11:00"}
            </li>
            <li>
              {ru ? "оплатить хостинг, пятница" : "pay for hosting, Friday"}
            </li>
            <li>{ru ? "купить корм коту" : "buy cat food"}</li>
          </ul>
          {ru
            ? "И напомню про созвон за 15 минут."
            : "And I'll remind you 15 minutes before the call."}
          <small>09:12</small>
        </div>
        <div class="tg-keyboard">
          <span>{ru ? "Открыть задачи" : "Open tasks"}</span>
          <span>{ru ? "Перенести" : "Reschedule"}</span>
        </div>
        <div class="msg outgoing">
          {scenarios[1][0]}
          <small>09:14 ✓✓</small>
        </div>
        <div class="msg incoming">
          {scenarios[1][1]}
          <small>09:14</small>
        </div>
      </>
    )}
  </div>
  {variant === "hero" && (
    <div class="tg-input">
      {ru ? "Сообщение" : "Message"}
      <span aria-hidden="true">⌁</span>
    </div>
  )}
</div>
