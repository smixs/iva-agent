---
import { cluster, type Corner } from "../lib/pixels";
const {
  seed,
  at,
  count = 11,
  cell = 9,
  edge = false,
} = Astro.props as {
  seed: number;
  at: Corner;
  count?: number;
  cell?: number;
  edge?: boolean;
};
---

<span class="px" data-at={at} aria-hidden="true">
  {cluster(seed, at, count, cell, edge).map((style) => <i style={style}></i>)}
</span>
