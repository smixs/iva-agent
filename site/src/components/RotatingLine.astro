---
import { extras } from "../data/home-extras";
import type { Lang } from "../lib/copy";
const { lang } = Astro.props as { lang: Lang };
const lines = extras[lang].verbs;
---

<div class="rotating-line" data-rotating-line>
  <svg
    width="18"
    height="22"
    viewBox="0 0 18 22"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M16 1C5 1 0 8 3 15c2 5 12 2 13-14ZM4 21l8-14" />
  </svg>
  <div>
    {lines.map((line, i) => (
      <span data-verb hidden={i !== 0}>
        {line}
      </span>
    ))}
  </div>
</div>
<script>
  const line = document.querySelector<HTMLElement>("[data-rotating-line]")!;
  const words = [...line.querySelectorAll<HTMLElement>("[data-verb]")];
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  let timer = 0,
    current = 0,
    visible = false;
  function show(index: number) {
    words.forEach((word, i) => (word.hidden = i !== index));
  }
  function update() {
    window.clearInterval(timer);
    line.classList.remove("is-playing");
    if (reduce.matches) {
      current = 0;
      show(0);
      return;
    }
    if (!visible || document.hidden) return;
    line.classList.add("is-playing");
    timer = window.setInterval(() => {
      current = (current + 1) % words.length;
      show(current);
    }, 2200);
  }
  new IntersectionObserver(([entry]) => {
    visible = entry.isIntersecting;
    update();
  }).observe(line);
  reduce.addEventListener("change", update);
  document.addEventListener("visibilitychange", update);
</script>
