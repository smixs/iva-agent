---
import usecases from "../data/usecases.json";
import { glue, type Lang } from "../lib/copy";
const { lang } = Astro.props as { lang: Lang };
// Where the phone is in each photo (the gift in the last one), in percent of the photo, and the
// side with open space in degrees (0 is right, -90 is up). Pixels drift off the phone that way.
const phones: Record<string, number[]> = {
  morning: [60, 55, -30], voice: [60, 42, -25], mail: [61, 43, -35], memory: [44, 56, -80],
  invoice: [53, 84, -70], goal: [31, 88, -110], birthday: [54, 50, -90], family: [68, 50, -95],
};
const shades = ["#ffffff", "#368ad2", "#d6e7f5", "#a4dc55", "#2b6291"];
const pixels = Object.fromEntries(Object.entries(phones).map(([id, [px, py, open]], photo) => {
  let seed = photo * 977 + 13;
  const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
  return [id, Array.from({ length: 14 }, (_, i) => {
    const angle = ((open + (i / 13 - 0.5) * 150 + (rand() - 0.5) * 16) * Math.PI) / 180;
    const near = 3 + rand() * 10;
    const far = 14 + rand() * 18;
    return {
      x: (px + Math.cos(angle) * near * 0.75).toFixed(1),
      y: (py + Math.sin(angle) * near).toFixed(1),
      size: [6, 8, 10, 12][Math.floor(rand() * 4)],
      shade: shades[(i * 3 + photo) % shades.length],
      dx: (Math.cos(angle) * far).toFixed(1),
      dy: (Math.sin(angle) * far).toFixed(1),
      time: (3 + rand() * 2.2).toFixed(2),
      delay: (-rand() * 5).toFixed(2),
    };
  })];
}));
const legacy = ["asks", "scenarios", "userbot"];
---

<section id="features" class="section use-cases" aria-label={usecases[lang].label}>
  {legacy.map((id) => <span id={id} class="legacy-anchor" aria-hidden="true"></span>)}
  <div class="usecase-rows">
    {usecases[lang].rows.map((row, index) => (
      <article id={row.id} class="usecase-row" aria-labelledby={`case-${row.id}`}>
        <div class="case-copy">
          <h2 id={`case-${row.id}`}>{glue(row.title)}</h2>
          <p>{glue(row.text)}</p>
        </div>
        <div class="case-art" data-case-art>
          <picture class="case-photo">
            <source type="image/avif" srcset={`/media/usecases/${row.id}-800.avif 800w, /media/usecases/${row.id}-1600.avif 1600w`} sizes="(max-width: 760px) calc(100vw - 44px), 52vw" />
            <img src={`/media/usecases/${row.id}-800.webp`} srcset={`/media/usecases/${row.id}-800.webp 800w, /media/usecases/${row.id}-1600.webp 1600w`} sizes="(max-width: 760px) calc(100vw - 44px), 52vw" width="1600" height="1200" alt={row.alt} loading="lazy" decoding="async" />
          </picture>
          {pixels[row.id].map((p) => (
            <span class="case-pixel" aria-hidden="true" style={`left: ${p.x}%; top: ${p.y}%; width: ${p.size}px; height: ${p.size}px; --shade: ${p.shade}; --dx: ${p.dx}px; --dy: ${p.dy}px; --time: ${p.time}s; --delay: ${p.delay}s`} />
          ))}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .case-art { position: relative; }
  .case-photo { display: block; }
  .case-pixel {
    position: absolute;
    background: var(--shade);
    box-shadow: 0 0 0 1px rgb(43 98 145 / 0.12);
    opacity: 0;
    pointer-events: none;
  }
  /* Only while the photo is on screen: each pixel fades in, drifts off the phone and fades out. */
  .case-art[data-live] .case-pixel { animation: case-pixel var(--time) cubic-bezier(0.37, 0, 0.63, 1) var(--delay) infinite; }
  @keyframes case-pixel {
    0% { opacity: 0; transform: translate(0, 0) scale(0.5); }
    20% { opacity: 0.95; transform: translate(calc(var(--dx) * 0.2), calc(var(--dy) * 0.2)) scale(1); }
    70% { opacity: 0.95; }
    100% { opacity: 0; transform: translate(var(--dx), var(--dy)) scale(0.7); }
  }
  @media (prefers-reduced-motion: reduce) {
    .case-pixel { display: none; }
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) entry.target.toggleAttribute("data-live", entry.isIntersecting);
  }, { rootMargin: "120px 0px" });
  document.querySelectorAll("[data-case-art]").forEach((art) => observer.observe(art));
</script>
