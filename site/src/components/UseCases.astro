---
import usecases from "../data/usecases.json";
import { glue, type Lang } from "../lib/copy";
const { lang } = Astro.props as { lang: Lang };
const legacy = ["asks", "scenarios", "userbot", "memory", "invoice", "goal", "family"];
---

<section id="features" class="section use-cases" aria-label={usecases[lang].label}>
  {legacy.map((id) => <span id={id} class="legacy-anchor" aria-hidden="true"></span>)}
  <div class="usecase-rows">
    {usecases[lang].rows.map((row) => (
      <article id={row.id} class="usecase-row" aria-labelledby={`case-${row.id}`}>
        <div class="case-copy">
          <h2 id={`case-${row.id}`}>{glue(row.title)}</h2>
          <p>{glue(row.text)}</p>
        </div>
        <picture class="case-art">
          <source type="image/avif" srcset={`/media/usecases/${row.id}-800.avif 800w, /media/usecases/${row.id}-1600.avif 1600w`} sizes="(max-width: 760px) calc(100vw - 44px), 52vw" />
          <img src={`/media/usecases/${row.id}-800.webp`} srcset={`/media/usecases/${row.id}-800.webp 800w, /media/usecases/${row.id}-1600.webp 1600w`} sizes="(max-width: 760px) calc(100vw - 44px), 52vw" width="1600" height="1200" alt={row.alt} loading="lazy" decoding="async" />
        </picture>
      </article>
    ))}
  </div>
</section>
