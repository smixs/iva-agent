---
import usecases from "../data/usecases.json";
import type { Lang } from "../lib/copy";
const { lang, title } = Astro.props as { lang: Lang; title: string };

// Glitch squares sit on the image edge that faces away from the text, where the
// generated pixels already are. Fixed positions keep every load identical.
// [left %, top %, size px]; the last one is the single lime square.
const EDGE: [number, number, number][] = [
  [3, 24, 7], [8, 46, 5], [2, 63, 8], [12, 82, 5], [15, 14, 5], [6, 54, 6],
];
const pixelsFor = (index: number) =>
  EDGE.map(([x, y, s], n) => ({
    // Odd rows put the image on the right, so the free edge is the right one.
    x: index % 2 === 0 ? x : 100 - x - 2,
    y: (y + index * 7) % 92 + 3,
    s,
    lime: n === EDGE.length - 1,
    dx: (index % 2 === 0 ? -1 : 1) * (24 + (n % 3) * 8),
    dy: (n % 2 === 0 ? -1 : 1) * (10 + (n % 4) * 6),
    delay: 0.18 + n * 0.035,
  }));
---

<section id="features" class="section use-cases">
  <span id="asks" class="legacy-anchor" aria-hidden="true"></span>
  <span id="scenarios" class="legacy-anchor" aria-hidden="true"></span>
  <h2>{title}</h2>
  <div class="usecase-rows">
    {usecases[lang].rows.map((row, index) => (
      <article class="usecase-row" data-usecase-row aria-labelledby={`case-${row.id}`}>
        <div class="case-art">
          <div class="case-motion" data-case-motion>
            <picture class="case-picture">
              <source type="image/avif" srcset={`/media/usecases/${row.id}-800.avif 800w, /media/usecases/${row.id}-1600.avif 1600w`} sizes="(max-width: 959px) 100vw, 58vw" />
              <img src={`/media/usecases/${row.id}-800.webp`} srcset={`/media/usecases/${row.id}-800.webp 800w, /media/usecases/${row.id}-1600.webp 1600w`} sizes="(max-width: 959px) 100vw, 58vw" width="1600" height="1200" alt={row.alt} loading="lazy" decoding="async" />
            </picture>
            <span class="case-pixels" aria-hidden="true">
              {pixelsFor(index).map((p) => (
                <i class={p.lime ? "lime" : undefined} style={`left:${p.x}%;top:${p.y}%;--s:${p.s}px;--dx:${p.dx}px;--dy:${p.dy}px;--d:${p.delay}s`} />
              ))}
            </span>
          </div>
        </div>
        <div class="case-copy">
          <h3 id={`case-${row.id}`}>{row.title}</h3>
          <p>{row.text}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<style is:global>
  .usecase-rows { margin-top: 56px; display: grid; gap: 120px; }
  .usecase-row {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 64px; align-items: center;
  }
  .usecase-row .case-art { grid-column: 1 / span 7; grid-row: 1; }
  .usecase-row .case-copy { grid-column: 8 / span 5; grid-row: 1; }
  .usecase-row:nth-child(even) .case-art { grid-column: 6 / span 7; }
  .usecase-row:nth-child(even) .case-copy { grid-column: 1 / span 5; }

  .case-art { min-width: 0; aspect-ratio: 4 / 3; }
  .case-motion { position: relative; transform: translate3d(0, var(--case-y, 0px), 0); will-change: transform; }
  .case-picture, .case-picture img { display: block; width: 100%; height: auto; }
  /* Generated art is near-white, not white, at its edges; a soft elliptical mask
     removes the faint rectangle so each picture melts into the page. */
  .case-picture img {
    -webkit-mask-image: radial-gradient(closest-side, #000 80%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 80%, transparent 100%);
  }

  .case-copy { min-width: 0; max-width: 34ch; }
  .case-copy h3 {
    margin: 0 0 14px; font-size: clamp(32px, 3.2vw, 44px); line-height: 1.08;
    letter-spacing: -.03em; font-weight: 700; color: #1a2327;
  }
  .case-copy p { margin: 0; font-size: 19px; line-height: 1.5; color: #5b6770; }

  .case-pixels { position: absolute; inset: 0; pointer-events: none; }
  .case-pixels i { position: absolute; width: var(--s); height: var(--s); background: #368ad2; }
  .case-pixels i.lime { background: #a4dc55; }

  /* Motion runs only when scripting marks the page ready, so without JS everything is visible. */
  .js-motion .usecase-row .case-art,
  .js-motion .usecase-row .case-copy { opacity: 0; transform: translateY(24px); }
  .js-motion .usecase-row .case-pixels i { opacity: 0; transform: translate(var(--dx), var(--dy)); }
  .js-motion .usecase-row.is-entered .case-art,
  .js-motion .usecase-row.is-entered .case-copy {
    opacity: 1; transform: none;
    transition: opacity .6s cubic-bezier(.2,.7,.2,1), transform .6s cubic-bezier(.2,.7,.2,1);
  }
  .js-motion .usecase-row.is-entered .case-copy { transition-delay: .12s; }
  .js-motion .usecase-row.is-entered .case-pixels i {
    animation: case-pixel-in .45s var(--d) cubic-bezier(.2,.7,.2,1) both, case-pixel-blink .4s calc(var(--d) + .45s) steps(2, jump-none) 2;
  }
  @keyframes case-pixel-in { from { opacity: 0; transform: translate(var(--dx), var(--dy)); } to { opacity: 1; transform: none; } }
  @keyframes case-pixel-blink { 0% { opacity: 1; } 50% { opacity: .15; } 100% { opacity: 1; } }

  @media (max-width: 959px) {
    .usecase-rows { margin-top: 32px; gap: 72px; }
    .usecase-row { display: block; }
    .case-copy { max-width: none; margin-top: 24px; }
    .case-copy h3 { font-size: clamp(28px, 7.4vw, 32px); margin-bottom: 12px; }
    .case-copy p { font-size: 18px; }
    .case-motion { transform: none; will-change: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .js-motion .usecase-row .case-art, .js-motion .usecase-row .case-copy,
    .js-motion .usecase-row .case-pixels i { opacity: 1; transform: none; animation: none; transition: none; }
    .case-motion { transform: none; }
  }
</style>

<script>
  const rows = [...document.querySelectorAll<HTMLElement>("[data-usecase-row]")];
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  const wide = matchMedia("(min-width: 960px)");
  const visible = new Set<HTMLElement>();
  let frame = 0;

  if (!reduced.matches) document.documentElement.classList.add("js-motion");

  // Parallax: ±12 px around the viewport centre, desktop only, visible rows only.
  function paint() {
    frame = 0;
    for (const row of visible) {
      const motion = row.querySelector<HTMLElement>("[data-case-motion]");
      if (!motion) continue;
      const rect = row.getBoundingClientRect();
      const y = Math.max(-12, Math.min(12, ((innerHeight / 2 - rect.top - rect.height / 2) / innerHeight) * 24));
      motion.style.setProperty("--case-y", `${y.toFixed(1)}px`);
    }
  }
  function requestPaint() {
    if (!frame && visible.size && wide.matches && !reduced.matches && !document.hidden) frame = requestAnimationFrame(paint);
  }

  const enter = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      entry.target.classList.add("is-entered");
      enter.unobserve(entry.target);
    }
  }, { threshold: 0.25 });
  const track = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      const row = entry.target as HTMLElement;
      if (entry.isIntersecting) visible.add(row);
      else visible.delete(row);
    }
    requestPaint();
  });
  rows.forEach((row) => { enter.observe(row); track.observe(row); });
  addEventListener("scroll", requestPaint, { passive: true });
  addEventListener("resize", requestPaint);
  reduced.addEventListener("change", () => {
    document.documentElement.classList.toggle("js-motion", !reduced.matches);
    rows.forEach((row) => row.querySelector<HTMLElement>("[data-case-motion]")?.style.removeProperty("--case-y"));
  });
</script>
