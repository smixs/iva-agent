---
import TelegramFrame from "./TelegramFrame.astro";
import { extras } from "../data/home-extras";
import type { Lang } from "../lib/copy";
const { lang } = Astro.props as { lang: Lang };
const copy = extras[lang];
---

<section id="overnight" class="section overnight split">
  <div>
    <h2>{copy.overnight}</h2>
    <p>{copy.morningText}</p>
  </div>
  <TelegramFrame lang={lang} compact>
    <div class="telegram-date">
      {lang === "ru" ? "Пока вы спали" : "While you slept"}
    </div>
    {copy.morning.map((text, i) => (
      <div
        class="telegram-bubble telegram-in"
        data-chat-step={`morning-${i}`}
        data-at={700 + i * 1500}
      >
        {text}
        <span class="telegram-time">07:0{i}</span>
      </div>
    ))}
  </TelegramFrame>
</section>
