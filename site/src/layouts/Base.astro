---
import "../styles/global.css";
import Analytics from "../components/Analytics.astro";
import Footer from "../components/Footer.astro";

import type { Lang } from "../lib/copy";
const {
  title,
  description,
  lang = "en",
  en,
  ru,
  schema = [],
  noindex = false,
  ruAlternate = true,
  intro = false,
} = Astro.props as {
  title: string;
  description: string;
  lang?: Lang;
  en?: string;
  ru?: string;
  schema?: unknown[];
  noindex?: boolean;
  ruAlternate?: boolean;
  intro?: boolean;
};
const isRu = lang === "ru";
const home = isRu ? "/ru/" : "/";
const canonical = new URL(Astro.url.pathname, Astro.site);
const enPath = en || Astro.url.pathname.replace(/^\/ru\//, "/");
const ruPath = ru || (enPath === "/privacy/" ? "/privacy/" : "/ru" + enPath);
const og = `/media/og-${lang}.png`;
const nav = isRu
  ? ["Примеры задач", "Сервисы", "Цена", "Установка"]
  : ["Features", "Services", "Price", "Install"];
const links = ["features", "connections", "price", "install"];
---

<!doctype html>
<html lang={lang}>
  <head>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    {intro && (
      <script is:inline>
        // The opening (Home.astro) is decided before the first paint, so nothing shows ahead of the
        // leaf: once per session, not on a link to a section, not with reduced motion, not going back.
        try {
          const nav = performance.getEntriesByType("navigation")[0];
          if (!sessionStorage.getItem("iva-intro") && !location.hash && !matchMedia("(prefers-reduced-motion: reduce)").matches && (!nav || nav.type !== "back_forward")) document.documentElement.dataset.intro = "play";
        } catch {}
      </script>
    )}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    {ruAlternate && (
      <link rel="alternate" hreflang="ru" href={new URL(ruPath, Astro.site)} />
    )}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(enPath, Astro.site)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(og, Astro.site)} />
    <meta property="og:locale" content={isRu ? "ru_RU" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(og, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <slot name="head" />

    {schema.map((item) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(item).replaceAll("<", "\\u003c")}
      />
    ))}
  </head>
  <body>
    <a class="skip" href="#main">
      {isRu ? "К содержанию" : "Skip to content"}
    </a>
    <header class="header">
      <a
        class="logo"
        href={home}
        aria-label={isRu ? "Ива, главная" : "Iva home"}
      >
        <img
          class="full-logo"
          src="/brand/logo-light.svg"
          alt="IVA"
          width="104"
          height="58"
        />
        <img
          class="mobile-mark"
          src="/brand/mark.svg"
          alt="IVA"
          width="40"
          height="40"
        />
      </a>
      <nav aria-label={isRu ? "Главная навигация" : "Main navigation"}>
        {nav.map((n, i) => (
          <a href={home + "#" + links[i]}>{n}</a>
        ))}
      </nav>
      <button
        class="mobile-toggle"
        hidden
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="sr-only">{isRu ? "Меню" : "Menu"}</span>
        <svg class="menu-open-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
        <svg class="menu-close-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
      </button>
      <div class="header-actions">
        <a
          class="language"
          href={isRu ? enPath : ruPath}
          lang={isRu ? "en" : "ru"}
        >
          {isRu ? "EN" : "RU"}
        </a>
        <a
          class="github"
          href="https://github.com/smixs/iva-agent"
          aria-label="GitHub"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
          </svg>
          <span>GitHub</span>
        </a>
        <a class="button small" href={home + "#install"}>
          {isRu ? "Установить" : "Install"}
        </a>
      </div>
    </header>
    <nav
      id="mobile-nav"
      class="mobile-nav"
      aria-label={isRu ? "Мобильная навигация" : "Mobile navigation"}
    >
      <div class="mobile-nav-links">
        {nav.map((n, i) => (
          <a href={home + "#" + links[i]}><span>{n}</span></a>
        ))}
      </div>
      <div class="mobile-nav-footer">
        <span>{isRu ? "Язык" : "Language"}</span>
        <a href={isRu ? enPath : ruPath} lang={isRu ? "en" : "ru"}>{isRu ? "English" : "Русский"}</a>
      </div>
    </nav>
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} home={home} other={isRu ? enPath : ruPath} />
    <Analytics lang={lang} />
    <script>
      const menu = document.querySelector<HTMLElement>("#mobile-nav")!;
      const toggle =
        document.querySelector<HTMLButtonElement>(".mobile-toggle")!;
      menu.hidden = true;
      toggle.hidden = false;
      function close() {
        menu.hidden = true;
        menu.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
        toggle.focus();
      }
      toggle.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") === "true";
        menu.hidden = open;
        menu.classList.toggle("is-open", !open);
        toggle.setAttribute("aria-expanded", String(!open));
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !menu.hidden) close();
      });
      document.addEventListener("click", (event) => {
        if (
          !menu.hidden &&
          !menu.contains(event.target as Node) &&
          !toggle.contains(event.target as Node)
        )
          close();
      });
      menu.querySelectorAll("a").forEach((link) =>
        link.addEventListener("click", (event) => {
          const url = new URL(link.href);
          close();
          if (url.pathname === location.pathname && url.hash) {
            event.preventDefault();
            document.querySelector(url.hash)?.scrollIntoView();
            history.pushState(null, "", url.hash);
          }
        }),
      );
    </script>
  </body>
</html>
