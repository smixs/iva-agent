---
import "../styles/global.css";
import Analytics from "../components/Analytics.astro";

import { homeCopy, type Lang } from "../lib/copy";
import Icon from "../components/Icon.astro";
import cyrillic from "../assets/fonts/unbounded-700-cyrillic.woff2?url";
import latin from "../assets/fonts/unbounded-700-latin.woff2?url";
import { stats } from "../lib/stats";
const {
  title,
  description,
  lang = "en",
  en,
  ru,
  schema = [],
  noindex = false,
  ruAlternate = true,
} = Astro.props as {
  title: string;
  description: string;
  lang?: Lang;
  en?: string;
  ru?: string;
  schema?: unknown[];
  noindex?: boolean;
  ruAlternate?: boolean;
};
const isRu = lang === "ru";
const home = isRu ? "/ru/" : "/";
const canonical = new URL(Astro.url.pathname, Astro.site);
const enPath = en || Astro.url.pathname.replace(/^\/ru\//, "/");
const ruPath = ru || (enPath === "/privacy/" ? "/privacy/" : "/ru" + enPath);
const og = `/media/og-${lang}.png`;
const c = homeCopy[lang];
const prefix = isRu ? "/ru" : "";
const footerLinks = [
  prefix + "/docs/",
  "https://github.com/smixs/iva-agent/blob/main/CHANGELOG.md",
  prefix + "/about/",
  "/privacy/",
  "/docs/brand/",
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    {ruAlternate && (
      <link rel="alternate" hreflang="ru" href={new URL(ruPath, Astro.site)} />
    )}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(enPath, Astro.site)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(og, Astro.site)} />
    <meta property="og:locale" content={isRu ? "ru_RU" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(og, Astro.site)} />
    <link rel="preload" href={latin} as="font" type="font/woff2" crossorigin />
    {isRu && (
      <link rel="preload" href={cyrillic} as="font" type="font/woff2" crossorigin />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {schema.map((item) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(item).replaceAll("<", "\\u003c")}
      />
    ))}
  </head>
  <body>
    <a class="skip" href="#main">
      {isRu ? "К содержанию" : "Skip to content"}
    </a>
    <header class="header wrap">
      <a class="logo" href={home} aria-label={isRu ? "Ива, главная" : "Iva home"}>
        <img src="/brand/logo-light.svg" alt="IVA" width="96" height="54" />
      </a>
      <nav class="nav" aria-label={isRu ? "Главная навигация" : "Main navigation"}>
        {c.nav.map(([label, id]) => <a href={home + "#" + id}>{label}</a>)}
      </nav>
      <div class="header-actions">
        <a class="language" href={isRu ? enPath : ruPath} lang={isRu ? "en" : "ru"}>
          {isRu ? "EN" : "RU"}
        </a>
        <a
          class="github"
          href="https://github.com/smixs/iva-agent"
          aria-label={`GitHub, ${stats.stars} ${isRu ? "звёзд" : "stars"}`}
        >
          <Icon name="github" size={22} />
          <span>{stats.stars}</span>
        </a>
        <button class="mobile-toggle" hidden aria-expanded="false" aria-controls="mobile-nav">
          {c.menu}
        </button>
      </div>
    </header>
    <nav id="mobile-nav" class="mobile-nav" aria-label={isRu ? "Мобильная навигация" : "Mobile navigation"}>
      {c.nav.map(([label, id]) => <a href={home + "#" + id}>{label}</a>)}
      <a href={home + "#install"}>{c.install}</a>
      <a href={isRu ? enPath : ruPath}>{isRu ? "English" : "Русский"}</a>
    </nav>
    <main id="main">
      <slot />
    </main>
    <footer class="footer wrap">
      <div class="footer-top">
        <a href={home} class="footer-logo">
          <img src="/brand/logo-light.svg" alt="IVA" width="84" height="47" loading="lazy" decoding="async" />
        </a>
        <ul class="footer-meta">
          <li><a href="https://github.com/smixs/iva-agent/blob/main/LICENSE">{c.footer.mit}</a></li>
          <li><a href="https://github.com/smixs/iva-agent"><Icon name="github" size={18} />GitHub</a></li>
          <li><a href={home}>iva-agent.com</a></li>
        </ul>
      </div>
      <div class="footer-bottom">
        <nav aria-label={isRu ? "Ссылки в подвале" : "Footer links"}>
          {c.footer.links.map((n, i) => <a href={footerLinks[i]}>{n}</a>)}
          <a href={isRu ? enPath : ruPath}>{isRu ? "English" : "Русский"}</a>
        </nav>
        <p>
          © {new Date().getFullYear()} Majento, Tashkent. {c.footer.majento}{" "}
          <a href="https://majento.ai/?utm_source=iva-agent.com&amp;utm_medium=referral&amp;utm_campaign=ecosystem">Majento</a>
        </p>
      </div>
    </footer>
    <Analytics lang={lang} />
    <script>
      const menu = document.querySelector<HTMLElement>("#mobile-nav")!;
      const toggle =
        document.querySelector<HTMLButtonElement>(".mobile-toggle")!;
      menu.hidden = true;
      toggle.hidden = false;
      function close() {
        menu.hidden = true;
        menu.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
        toggle.focus();
      }
      toggle.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") === "true";
        menu.hidden = open;
        menu.classList.toggle("is-open", !open);
        toggle.setAttribute("aria-expanded", String(!open));
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !menu.hidden) close();
      });
      document.addEventListener("click", (event) => {
        if (
          !menu.hidden &&
          !menu.contains(event.target as Node) &&
          !toggle.contains(event.target as Node)
        )
          close();
      });
      menu.querySelectorAll("a").forEach((link) =>
        link.addEventListener("click", (event) => {
          const url = new URL(link.href);
          close();
          if (url.pathname === location.pathname && url.hash) {
            event.preventDefault();
            document.querySelector(url.hash)?.scrollIntoView();
            history.pushState(null, "", url.hash);
          }
        }),
      );
    </script>
  </body>
</html>
